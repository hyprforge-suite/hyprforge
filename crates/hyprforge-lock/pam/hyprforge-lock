#%PAM-1.0
#
# PAM configuration for hyprforge-lock. Install as /etc/pam.d/hyprforge-lock.
#
# Both stacks are needed, and the second is the one that is easy to
# forget. hyprforge-lock checks the account as well as the password,
# because authentication is not authorisation: an account can have the
# right password and still be expired, locked, or barred from this host,
# and unlocking a session PAM had refused would be a real hole.
#
# Borrowing /etc/pam.d/hyprlock does not work for that reason. It
# declares `auth include login` and nothing else, so the account stack
# for that service is empty and falls through to /etc/pam.d/other, which
# is `account required pam_deny.so`. The result is a correct password
# accepted by the auth stack and then denied by the account one.

auth      include   system-auth
account   include   system-auth
