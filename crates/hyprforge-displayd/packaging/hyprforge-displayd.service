[Unit]
Description=Hyprforge display manager
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/hyprforge-displayd run
# always, not on-failure. The daemon can exit *successfully* and stay
# dead: if the Wayland dispatch thread breaks out of its loop, its event
# senders drop, the run loop sees a closed channel and returns Ok, and
# main exits 0. on-failure does not restart a clean exit, so a compositor
# hiccup would leave displays unmanaged until the next login — with no
# failed unit to show for it.
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
