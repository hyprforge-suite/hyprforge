# Install as /usr/lib/tmpfiles.d/hyprforge-greet.conf, then:
#     systemd-tmpfiles --create
#
# Where the Settings app exports the look for the greeter to read. It
# has to live outside $HOME: a home directory is drwx------ and the
# greeter runs as another user, so it cannot traverse into one. That is
# a directory permission, not a file permission, so no amount of
# chmod-ing the theme itself would help.
#
# 2775: setgid, so everything written here keeps the hyprforge group
# and a second user's export stays readable by the greeter instead of
# landing group-root. Group-writable because the Settings app runs as
# you, unprivileged; world-readable because the greeter has to read it.
#
# The files inside are written 0644 by the exporting process's umask,
# which is what the greeter needs and no more.
d /var/lib/hyprforge      0755 root root      -
d /var/lib/hyprforge/greet 2775 root hyprforge -
