#!/usr/bin/env bash
# Before every commit: no staged pin names a commit missing from its
# repository's main, then `tools/hf check --fast` — clippy, docs, the
# static checks, every ignored test classified, and the unit tier.
#
# Enabled by `git config core.hooksPath .githooks`, which `./hyprforge
# --install` also sets (`tools/hf doctor` says whether it is). Nothing here
# needs a compositor, a daemon or the network, so it is safe on any
# machine and changes nothing outside target/.
#
# To commit anyway — a work-in-progress commit on a branch, say:
#   git commit --no-verify
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 1

if [[ ! -x tools/hf ]]; then
    echo "pre-commit: tools/hf is missing or not executable; skipping." >&2
    exit 0
fi

tools/hf precommit || {
    printf '\n\033[31mpre-commit: the fast check failed, so nothing was committed.\033[0m\n' >&2
    printf 'Fix the above, or use `git commit --no-verify` to commit regardless.\n\n' >&2
    exit 1
}
