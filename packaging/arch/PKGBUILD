# Maintainer: Adam Post <apost@intradatech.com>
#
# A **split package**: one source tree, one build, several packages.
#
# This is the answer to "if someone installs it from the AUR they get
# everything". They do not have to. `makepkg` builds the workspace once
# and then packages each component separately, so a person who wants the
# tray icons and nothing else installs `hyprforge-tray`, and a person who
# prefers dunst simply never installs the notification daemon.
#
# It is also why this project does not need one repository per component.
# Packaging granularity and repository granularity are different
# questions, and only the first one decides what a user can install.
# Debian (one source package, many binary packages), Fedora
# (`%package -n`) and Nix (several derivations from one flake) all work
# the same way.
#
# `hyprforge` itself is a metapackage: it depends on the others, so
# `pacman -S hyprforge` still gets the whole suite in one command.

pkgbase=hyprforge
pkgname=(
  hyprforge-settings
  hyprforge-lock
  hyprforge-greet
  hyprforge-displayd
  hyprforge-tray
  hyprforge-clipboard
  hyprforge-emojimenu
  hyprforge-files
  hyprforge-media
  hyprforge-notif
  hyprforge
)
pkgver=0.1.0
pkgrel=1
pkgdesc="Native Hyprland desktop applications"
arch=(x86_64)
url="https://github.com/hyprforge-suite/hyprforge"
license=(MIT)
makedepends=(cargo git)
options=(!lto)
source=()

prepare() {
  cd "$startdir/../.."
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked
  # notif is a workspace of its own with its own Cargo.lock — see
  # `exclude` in the root Cargo.toml — so it is fetched, built and tested
  # on its own as well.
  (cd crates/hyprforge-notif && cargo fetch --locked)
}

build() {
  cd "$startdir/../.."
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  # One build for every package below. Splitting the repository would
  # mean building the shared crates once per component instead.
  cargo build --release --frozen --workspace
  (cd crates/hyprforge-notif && cargo build --release --frozen --workspace)
}

check() {
  cd "$startdir/../.."
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  # Tier 1 only. The other tiers need a running compositor, NetworkManager,
  # BlueZ, logind and a bar, none of which exist in a build chroot — see
  # check.sh's header.
  cargo test --release --frozen --workspace
  (cd crates/hyprforge-notif && cargo test --release --frozen --workspace)
}

_bin() {
  install -Dm755 "$srcdir/target/release/$1" "$pkgdir/usr/bin/$1"
}

package_hyprforge-settings() {
  pkgdesc="Settings application for Hyprland"
  depends=(wayland libxkbcommon)
  optdepends=(
    'hyprforge-displayd: monitor arrangement that remembers your setups'
    'hyprforge-tray: tray icons for Wi-Fi, Bluetooth, keep awake and night light'
    'hyprpaper: wallpaper'
    'hyprsunset: night light'
    'hypridle: idle timeouts'
  )
  cd "$startdir/../.."
  _bin hyprforge-settings
  install -Dm644 crates/hyprforge-settings/packaging/hyprforge-settings.desktop \
    "$pkgdir/usr/share/applications/hyprforge-settings.desktop"
}

package_hyprforge-files() {
  pkgdesc="File manager for Hyprland"
  depends=(wayland libxkbcommon)
  optdepends=(
    # Each of these degrades to a sentence in the preview pane naming the
    # program to install, never a file manager that fails to start.
    'xdg-utils: opening a file with the application you have chosen for it'
    'poppler: previews and thumbnails of PDFs (pdftoppm)'
    'ffmpeg: previews and thumbnails of videos'
  )
  cd "$startdir/../.."
  _bin hyprforge-files
  install -Dm644 crates/hyprforge-files/packaging/hyprforge-files.desktop \
    "$pkgdir/usr/share/applications/hyprforge-files.desktop"
}

package_hyprforge-media() {
  pkgdesc="Photo, video and 3D model viewer for Hyprland"
  depends=(wayland libxkbcommon)
  optdepends=(
    # Each of these is an action that degrades to a sentence without its
    # program, never a viewer that fails to start — see the plan's
    # "every sibling may be absent".
    'glib2: "Open With…" hands a picture to another program through gio'
    'hyprpaper: "Set as Wallpaper" shows it now, not only at next login'
    'hyprforge-files: "Show in Files"'
    # libmpv is opened at run time, not linked: without it every picture
    # and model still shows, and a video says what is missing.
    'mpv: playing videos'
    'ffmpeg: thumbnails of videos, from their first real frame'
  )
  cd "$startdir/../.."
  _bin hyprforge-media
  install -Dm644 crates/hyprforge-media/packaging/hyprforge-media.desktop \
    "$pkgdir/usr/share/applications/hyprforge-media.desktop"
}

package_hyprforge-lock() {
  pkgdesc="Lock screen for Hyprland (ext-session-lock-v1)"
  depends=(wayland libxkbcommon pam)
  cd "$startdir/../.."
  _bin hyprforge-lock
  # Its own PAM stack, deliberately. Borrowing hyprlock's accepts a
  # correct password and then denies it, because that file declares no
  # account stack and falls through to `account required pam_deny.so`.
  install -Dm644 crates/hyprforge-lock/pam/hyprforge-lock \
    "$pkgdir/etc/pam.d/hyprforge-lock"
}

package_hyprforge-greet() {
  pkgdesc="greetd greeter sharing the lock screen's look"
  depends=(wayland libxkbcommon pam greetd)
  cd "$startdir/../.."
  _bin hyprforge-greet
}

package_hyprforge-displayd() {
  pkgdesc="Display daemon that remembers monitor layouts"
  depends=(wayland)
  cd "$startdir/../.."
  _bin hyprforge-displayd
  _bin hyprforge-displayctl
  install -Dm644 crates/hyprforge-displayd/packaging/hyprforge-displayd.service \
    "$pkgdir/usr/lib/systemd/user/hyprforge-displayd.service"
}

package_hyprforge-tray() {
  pkgdesc="Tray icons for Wi-Fi, Bluetooth, keep awake and night light"
  # wayland/libxkbcommon: hyprforge-traymenu draws its own right-click
  # menu (com.canonical.dbusmenu is no longer served — see
  # hyprforge-tray's own module doc), a layer-shell popup on the same
  # stack as hyprforge-clipmenu, confirmed with ldd against this same
  # build rather than assumed from that package's own depends. Nothing
  # else is required for hyprforge-trayd itself: each icon needs its own
  # service, and the daemon reports "NetworkManager isn't running" rather
  # than failing, so the tray is useful with any subset of them present —
  # and a missing hyprforge-traymenu is the same kind of state, not a
  # crash: a right click falls back to the icon's primary action.
  depends=(wayland libxkbcommon)
  optdepends=(
    'networkmanager: the Wi-Fi icon'
    'bluez: the Bluetooth icon'
    'hyprsunset: the night light icon'
    'hyprforge-settings: the screens its icons open'
  )
  cd "$startdir/../.."
  _bin hyprforge-trayd
  _bin hyprforge-traymenu
  install -Dm644 crates/hyprforge-tray/packaging/hyprforge-trayd.service \
    "$pkgdir/usr/lib/systemd/user/hyprforge-trayd.service"
}

package_hyprforge-clipboard() {
  pkgdesc="Clipboard history with a popup at the pointer"
  depends=(wayland libxkbcommon)
  cd "$startdir/../.."
  _bin hyprforge-clipd
  _bin hyprforge-clipmenu
  install -Dm644 crates/hyprforge-clipboard/packaging/hyprforge-clipd.service \
    "$pkgdir/usr/lib/systemd/user/hyprforge-clipd.service"
}

package_hyprforge-emojimenu() {
  pkgdesc="Emoji picker popup at the pointer"
  # Same runtime linkage as hyprforge-clipmenu (confirmed with ldd against
  # this same build, not assumed from the clipboard package's own list):
  # libxkbcommon for keymap handling, wayland for the layer-shell surface
  # and protocols it dlopens at runtime. `noto-fonts-emoji` is a hard
  # dependency, not an optdepend: a picker that cannot render the very
  # thing it exists to pick is broken, not degraded, and this crate
  # deliberately has no runtime check or fallback message for a missing
  # emoji font — the package requiring one is what keeps that true.
  depends=(wayland libxkbcommon noto-fonts-emoji)
  # The Kaomoji tab is the opposite case: most of it draws from any Latin
  # font, but the shrug's ツ and several others are Japanese characters,
  # and without a CJK font those few render with gaps. The tab still
  # works — degraded, not broken — so this is an optdepend.
  optdepends=('noto-fonts-cjk: kaomoji that use Japanese characters, like the shrug')
  cd "$startdir/../.."
  _bin hyprforge-emojimenu
}

package_hyprforge-notif() {
  pkgdesc="Notification daemon and notification center, with notifctl to drive them"
  # Nothing but libc: notif's Wayland and D-Bus clients are pure Rust,
  # and `ldd notifd` names no libwayland, libxkbcommon or libdbus. The
  # standalone notif-git package listed `wayland` without needing it.
  depends=(gcc-libs glibc)
  # The binaries keep the names they had as notif — users bind
  # `notifctl center` and write `layerrule = blur, notif` — so this
  # package replaces the old one rather than installing beside it.
  provides=(notif notif-git)
  conflicts=(notif notif-git)
  replaces=(notif-git)
  cd "$startdir/../.."
  _bin notifd
  _bin notifctl
  install -Dm644 crates/hyprforge-notif/notifd.service \
    "$pkgdir/usr/lib/systemd/user/notifd.service"
}

package_hyprforge() {
  pkgdesc="Native Hyprland desktop applications (everything)"
  depends=(
    hyprforge-settings
    hyprforge-lock
    hyprforge-displayd
    hyprforge-tray
    hyprforge-clipboard
    hyprforge-emojimenu
    hyprforge-files
    hyprforge-media
    hyprforge-notif
  )
  # The greeter is deliberately not here. Installing it is not the
  # dangerous step — enabling greetd is, because that decides which VT
  # the machine logs in on. Pulling it in with a metapackage would put it
  # one `systemctl enable` away from a machine that cannot log in.
  optdepends=('hyprforge-greet: replace your display manager')
}
