pkgbase = hyprforge
	pkgdesc = Native Hyprland desktop applications
	pkgver = 0.1.9
	pkgrel = 1
	url = https://github.com/hyprforge-suite/hyprforge
	arch = x86_64
	license = MIT
	makedepends = cargo
	makedepends = git
	options = !lto
	source = hyprforge::git+https://github.com/hyprforge-suite/hyprforge.git#tag=v0.1.9
	source = hyprforge-clipboard::git+https://github.com/hyprforge-suite/hyprforge-clipboard.git
	source = hyprforge-displayd::git+https://github.com/hyprforge-suite/hyprforge-displayd.git
	source = hyprforge-emojimenu::git+https://github.com/hyprforge-suite/hyprforge-emojimenu.git
	source = hyprforge-files::git+https://github.com/hyprforge-suite/hyprforge-files.git
	source = hyprforge-greet::git+https://github.com/hyprforge-suite/hyprforge-greet.git
	source = hyprforge-lock::git+https://github.com/hyprforge-suite/hyprforge-lock.git
	source = hyprforge-media::git+https://github.com/hyprforge-suite/hyprforge-media.git
	source = hyprforge-notif::git+https://github.com/hyprforge-suite/hyprforge-notif.git
	source = hyprforge-settings::git+https://github.com/hyprforge-suite/hyprforge-settings.git
	source = hyprforge-tray::git+https://github.com/hyprforge-suite/hyprforge-tray.git
	sha256sums = SKIP
	sha256sums = SKIP
