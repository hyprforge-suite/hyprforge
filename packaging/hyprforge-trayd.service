[Unit]
Description=Hyprforge tray icons
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/hyprforge-trayd
# The daemon waits for a StatusNotifierWatcher rather than exiting when
# there is not one yet, so starting before the bar is not a race it can
# lose — and it re-announces when the bar restarts. `always` rather than
# `on-failure` for the same reason the display daemon uses it: a clean
# exit that leaves the tray empty is exactly as bad as a crash, and does
# not show up as a failed unit.
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
