#!/usr/bin/env bash
# Installs, updates and removes the parts of Hyprforge that live outside
# this repository.
#
#     ./hyprforge --install   --greeter
#     ./hyprforge --uninstall --greeter --force-cleanup
#     ./hyprforge --status
#
# Install and update are the same operation. Everything here is
# idempotent: it builds, compares what is installed against what was
# built, and copies only what differs. Running it twice changes nothing
# the second time, which is what makes it safe to run whenever you are
# not sure.
#
# Why a script rather than instructions in a README: testing the greeter
# means reinstalling it repeatedly, and the failure that wastes the most
# time is testing a binary that was never replaced. This verifies the
# copy landed instead of assuming it, because assuming it cost two full
# debugging rounds.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

readonly PREFIX=/usr/local/bin
readonly EXPORT_DIR=/var/lib/hyprforge/greet
readonly GREETD_DIR=/etc/greetd

DRY_RUN=false
FORCE_CLEANUP=false
# See --provide-mimetype. Off by default: putting a `mimetype` on PATH
# changes how every application on the machine opens files, which is not
# something to do as a side effect of installing a file manager.
PROVIDE_MIMETYPE=false
ASSUME_YES=false
ACTION=
COMPONENTS=()

# ---------------------------------------------------------------- output

if [[ -t 1 ]]; then
    B=$'\033[1m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; D=$'\033[2m'; N=$'\033[0m'
else
    B=; G=; Y=; R=; D=; N=
fi

step() { printf '%s==> %s%s\n' "$B" "$*" "$N"; }
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
skip() { printf '  %s·%s %s%s%s\n' "$D" "$N" "$D" "$*" "$N"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; }
die()  { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

# "$dst is current" repeats up to a dozen times in a `--install --all` run
# and buries the handful of lines that actually say something changed.
# Tally it instead of printing each one, and flush the tally right where
# the individual lines used to sit — so the count stays exactly as
# inline as what it replaces; it just stops repeating itself.
CURRENT_COUNT=0
mark_current() { (( CURRENT_COUNT += 1 )) || true; }
flush_current() {
    (( CURRENT_COUNT > 0 )) || return 0
    skip "$CURRENT_COUNT already current"
    CURRENT_COUNT=0
}

# Every component used to print its own "==> X: next steps" block right
# where it ran, which meant `--install --all` interleaved six essays into
# the action log and you could no longer see what the script had actually
# done by the time it finished. Each component appends its block to one
# of these instead, and the whole thing is printed once, at the end, in
# a fixed order rather than install order — see print_next_steps.
NEXT_DISPLAYD=
NEXT_TRAY=
NEXT_CLIPBOARD=
COMPONENT_CHANGED=false
NO_RESTART=false
NEXT_EMOJI=
NEXT_FILES=
STATE_EMOJI=todo
REASON_EMOJI=
STATE_FILES=todo
REASON_FILES=
NEXT_PHOTOS=
STATE_PHOTOS=todo
REASON_PHOTOS=
NEXT_LOCK=
NEXT_SETTINGS=
NEXT_GREETER=

# One of done / todo / unknown per block above (see "next-step checks"
# below for what each means) plus, for `unknown`, the reason it could
# not be determined. Set by each install_* function right after it
# builds the NEXT_* text, from a live but bounded check of the system —
# never from anything install_* just did, since --dry-run must report
# the same states as a real run.
STATE_DISPLAYD=;  REASON_DISPLAYD=
STATE_TRAY=;      REASON_TRAY=
STATE_CLIPBOARD=; REASON_CLIPBOARD=
STATE_LOCK=;      REASON_LOCK=
STATE_SETTINGS=;  REASON_SETTINGS=
STATE_GREETER=;   REASON_GREETER=

# Prints every captured block as one numbered list, ordered by
# consequence rather than by the order components were installed:
# services to enable first, then the config the user has to point at
# Hyprforge, and the greeter's block last — it's the one with real
# consequences (a bad greetd config can leave the machine unable to log
# in), so it belongs where it gets read most carefully: last, right
# before the script says it's done.
# ------------------------------------------------------- next-step checks
#
# Three states, not two: `done` (verified satisfied — omit the step),
# `todo` (verified outstanding — print it exactly as before) and
# `unknown` (the check itself could not run: a missing command, an
# unreadable file, systemd not answering). Collapsing `unknown` into
# either neighbour is the same mistake CLAUDE.md calls out for a test
# that returns early and still prints `ok`: a step nobody could verify
# must never come out looking finished (the user stops looking for it)
# or vanish silently (worse — there is then no record it was even
# checked). It gets its own visible, marked line instead.
CHECK_STATE=
CHECK_REASON=

# service_state --user|--system <unit>
# Sets CHECK_STATE / CHECK_REASON. Every systemctl call here is wrapped
# in `timeout` — CLAUDE.md is explicit that nothing here waits on
# another process without a bound, and `is-enabled` talking to a wedged
# systemd is exactly that kind of call.
service_state() {
    local scope=$1 unit=$2 state rc=0
    CHECK_REASON=
    if ! command -v systemctl >/dev/null 2>&1; then
        CHECK_STATE=unknown; CHECK_REASON="systemctl not found"
        return
    fi
    if [[ $scope == --user ]]; then
        if state=$(timeout 3 systemctl --user is-enabled "$unit" 2>/dev/null); then rc=0; else rc=$?; fi
    else
        if state=$(timeout 3 systemctl is-enabled "$unit" 2>/dev/null); then rc=0; else rc=$?; fi
    fi
    # 124 is timeout's own "gave up" exit code; 126/127 mean the command
    # never even ran. Anything else is systemctl actually answering —
    # is-enabled exits non-zero for "disabled" and "not-found" too, and
    # that is a real answer, not a failure to answer.
    if (( rc == 124 || rc == 126 || rc == 127 )); then
        CHECK_STATE=unknown
        CHECK_REASON="systemctl $scope is-enabled $unit did not answer"
        return
    fi
    if [[ $state == enabled ]]; then
        CHECK_STATE=done
    else
        CHECK_STATE=todo
    fi
}

# The lock step: is hypridle actually pointed at hyprforge-lock, not
# just mentioning it?
#
# A missing hypridle.conf and a present-but-commented-out one are both
# `todo`, but they are not the same state, in the same spirit as
# CLAUDE.md's "file could not be read is not the same as nothing
# configured": one means hypridle may not even be in use here, the
# other means it is in use and simply not wired up yet. Keeping the
# reasons distinct means a future addition of a real "can't tell" case
# does not get merged back into either by accident.
#
# The match is anchored to the start of the line (after whitespace) so
# that a commented line — "    # lock_cmd = ... hyprforge-lock", which
# is the literal contents of this machine's hypridle.conf — does NOT
# match: it starts with '#', not 'l'. A bare substring grep for
# "hyprforge-lock" anywhere in the file is exactly the trap this step
# exists to avoid.
lock_step_state() {
    local conf="$HOME/.config/hypr/hypridle.conf"
    CHECK_REASON=
    if [[ ! -e $conf ]]; then
        CHECK_STATE=todo
        CHECK_REASON="no ~/.config/hypr/hypridle.conf yet — hypridle may not be in use"
        return
    fi
    if [[ ! -r $conf ]]; then
        CHECK_STATE=unknown
        CHECK_REASON="$conf exists but could not be read"
        return
    fi
    if grep -Eq '^[[:space:]]*lock_cmd[[:space:]]*=.*hyprforge-lock' "$conf"; then
        CHECK_STATE=done
    else
        CHECK_STATE=todo
    fi
}

# The clipboard step is really two conditions — the daemon enabled, and
# the popup bound — and both have to hold before the instruction is
# moot.
clipboard_step_state() {
    service_state --user hyprforge-clipd
    local svc_state=$CHECK_STATE svc_reason=$CHECK_REASON
    if [[ $svc_state == unknown ]]; then
        CHECK_STATE=unknown; CHECK_REASON=$svc_reason
        return
    fi

    local binds="$HOME/.config/hypr/hyprforge/keybinds.lua" bind_state
    if [[ ! -e $binds ]]; then
        # Same missing-vs-present distinction as hypridle: no
        # keybinds.lua at all is first-run, not a bind that went
        # missing. Either way the step is still outstanding, so it
        # stays `todo` rather than becoming `unknown`.
        bind_state=todo
    elif [[ ! -r $binds ]]; then
        CHECK_STATE=unknown
        CHECK_REASON="$binds exists but could not be read"
        return
    elif grep -q hyprforge-clipmenu "$binds" 2>/dev/null; then
        bind_state=done
    else
        bind_state=todo
    fi

    if [[ $svc_state == done && $bind_state == done ]]; then
        CHECK_STATE=done
    else
        CHECK_STATE=todo
    fi
}

# The greeter step is the one CLAUDE.md's own safety warning is about —
# a bad greetd config can leave the machine unable to log in — so this
# is deliberately the most conservative check here. `done` only when
# greetd is enabled AND this specific session can be confirmed to have
# come in through it. Enabled-but-unconfirmed, or the check itself
# failing, both stay `todo`: understating readiness just repeats a
# warning that was already true, but overstating it hides a warning
# about the machine's boot target, and only one of those is safe to get
# wrong.
greeter_step_state() {
    service_state --system greetd
    if [[ $CHECK_STATE == unknown ]]; then
        return
    fi
    if [[ $CHECK_STATE == todo ]]; then
        # Not enabled at all: the machine has not committed to greetd,
        # so the full "test on a spare VT" warning must stay exactly as
        # visible as it is today. Nothing more to add.
        CHECK_REASON=
        return
    fi

    # greetd is enabled — but that alone only means it will be used on
    # the NEXT login, not that this session came in through it.
    if ! command -v loginctl >/dev/null 2>&1 || [[ -z ${XDG_SESSION_ID:-} ]]; then
        CHECK_STATE=unknown
        CHECK_REASON="greetd is enabled, but could not confirm this session logged in through it (no loginctl or session id)"
        return
    fi
    local service rc=0
    if service=$(timeout 3 loginctl show-session "$XDG_SESSION_ID" -p Service --value 2>/dev/null); then
        rc=0
    else
        rc=$?
    fi
    if (( rc == 124 || rc == 126 || rc == 127 )) || [[ -z $service ]]; then
        CHECK_STATE=unknown
        CHECK_REASON="loginctl did not answer about this session's Service"
        return
    fi
    if [[ $service == greetd ]]; then
        CHECK_STATE=done
    else
        # Conservative on purpose — see the function comment.
        CHECK_STATE=todo
        CHECK_REASON="greetd is enabled, but this session's Service is '$service', not greetd"
    fi
}

print_next_steps() {
    # Four arrays indexed in lockstep. Adding a component means adding
    # to all four at the same position — miss one and every entry after
    # it is labelled with its neighbour's name, which reads as a bug in
    # whichever component happened to land next to the gap.
    local labels=("Display daemon" "Tray icons" "Clipboard" "Emoji picker" "File manager" "Image viewer" "Lock" "Settings app" "Greeter")
    local texts=("$NEXT_DISPLAYD" "$NEXT_TRAY" "$NEXT_CLIPBOARD" "$NEXT_EMOJI" "$NEXT_FILES" "$NEXT_PHOTOS" "$NEXT_LOCK" "$NEXT_SETTINGS" "$NEXT_GREETER")
    local states=("$STATE_DISPLAYD" "$STATE_TRAY" "$STATE_CLIPBOARD" "$STATE_EMOJI" "$STATE_FILES" "$STATE_PHOTOS" "$STATE_LOCK" "$STATE_SETTINGS" "$STATE_GREETER")
    local reasons=("$REASON_DISPLAYD" "$REASON_TRAY" "$REASON_CLIPBOARD" "$REASON_EMOJI" "$REASON_FILES" "$REASON_PHOTOS" "$REASON_LOCK" "$REASON_SETTINGS" "$REASON_GREETER")

    # Steps that are `done` collapse into this count instead of being
    # read one by one, matching the "N already current" pattern used
    # for file installs above — the point there and here is the same:
    # say nothing was missed, then only enumerate what actually needs
    # attention.
    local out_labels=() out_texts=() out_states=() out_reasons=()
    local done_count=0 ran_any=false i
    for ((i = 0; i < ${#labels[@]}; i++)); do
        [[ -n ${texts[i]} ]] || continue   # component was not part of this run
        ran_any=true
        if [[ ${states[i]} == done ]]; then
            (( done_count += 1 ))
            continue
        fi
        out_labels+=("${labels[i]}")
        out_texts+=("${texts[i]}")
        out_states+=("${states[i]}")
        out_reasons+=("${reasons[i]}")
    done
    $ran_any || return 0

    # The heading has to agree with what follows it. "Before this does
    # anything, you need to:" above a list of nothing reads as a bug,
    # and on a machine that is already fully set up that is the common
    # case rather than the rare one.
    local plural="steps"
    (( done_count == 1 )) && plural="step"
    if (( ${#out_texts[@]} == 0 )); then
        step "Nothing left to do"
        (( done_count > 0 )) && skip "$done_count $plural already done"
    else
        step "Before this does anything, you need to:"
        (( done_count > 0 )) && skip "$done_count $plural already done"
    fi

    if (( ${#out_texts[@]} == 0 )); then
        # Every step this run touched is verified done, and any check
        # that could not run would still be sitting in out_texts above
        # (see the `unknown` branch below) — so an empty list here
        # really does mean nothing left, not a check that gave up.
        ok "everything this run set up is already wired in"
        return 0
    fi

    local n=1
    for ((i = 0; i < ${#out_texts[@]}; i++)); do
        printf '\n  %s%d. %s%s\n' "$B" "$n" "${out_labels[i]}" "$N"
        if [[ ${out_states[i]} == unknown ]]; then
            printf '  %s(could not verify whether this is still needed: %s)%s\n' \
                "$Y" "${out_reasons[i]}" "$N"
        fi
        printf '%s\n' "${out_texts[i]}"
        ((n++))
    done
}

# Every privileged action goes through here, so --dry-run is honest and
# there is exactly one place that can touch the system.
run_root() {
    if $DRY_RUN; then
        printf '  %s· would run: sudo %s%s\n' "$D" "$*" "$N"
        return 0
    fi
    sudo "$@"
}

confirm() {
    $ASSUME_YES && return 0
    $DRY_RUN && return 0
    local reply
    read -rp "  $1 [y/N] " reply
    [[ $reply == [yY] ]]
}

# ----------------------------------------------------------------- usage

usage() {
    cat <<EOF
${B}Usage:${N} ./hyprforge <action> [components] [options]

${B}Actions${N}
  --install        Build and install. Re-running updates in place.
  --uninstall      Remove what --install put on the system.
  --status         Show what is installed and whether it is current.

${B}Components${N}
  --greeter        The login screen: hyprforge-greet, its compositor
                   config, and the exported-look directory.
                   Does NOT enable greetd — see --install --greeter output.
  --lock           The lock screen: hyprforge-lock and its PAM stack.
  --displayd       The display daemon, as a systemd user service.
  --tray           The tray icons (Wi-Fi, Bluetooth, keep awake, night
                   light), as a systemd user service.
  --clipboard      Clipboard history: the daemon as a systemd user
                   service, plus the popup its keybind launches.
  --settings       The Settings app and its launcher entry.
  --files          The file manager, and its launcher entry.
  --photos         The image viewer, and its launcher entry.
  --mime           hyprforge-mimetype and hyprforge-mimeopen: what kind
                   of file is this, and what opens it. See
                   --provide-mimetype for the part that changes what the
                   rest of the desktop does.
  --emoji          The emoji picker popup, bound from Settings ->
                   Shortcuts (it has no daemon and no service).
  --all            Every component above.

${B}Options${N}
  --force-cleanup  On uninstall, also remove things shared with other
                   components or holding user data: the exported look,
                   the hyprforge group, /etc/greetd config. Off by
                   default because these are not yours alone.
  --provide-mimetype
                   With --mime, also provide the two commands under the
                   plain names `mimetype` and `mimeopen`, which is what
                   xdg-open looks for. This changes what happens when
                   *any* application on the desktop opens a file, so it
                   is off unless you ask. Uninstall removes the links
                   only if they still point at Hyprforge's binaries.
  --no-restart     Do not restart a running daemon whose binary changed.
                   The install still happens; the old process keeps
                   running until you restart it yourself.
  --dry-run        Print what would happen. Touches nothing.
  --yes            Do not ask for confirmation.
  -h, --help       This.

${B}Examples${N}
  ./hyprforge --install --greeter         # install or update the greeter
  ./hyprforge --status                    # what is installed, is it stale
  ./hyprforge --uninstall --greeter --force-cleanup
EOF
}

# ------------------------------------------------------------- arguments

[[ $# -eq 0 ]] && { usage; exit 1; }

set_action() {
    [[ -n $ACTION ]] && die "--install, --uninstall and --status are mutually exclusive"
    ACTION=$1
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --install)       set_action install ;;
        --uninstall)     set_action uninstall ;;
        --status)        set_action status ;;
        --greeter)       COMPONENTS+=(greeter) ;;
        --lock)          COMPONENTS+=(lock) ;;
        --displayd)      COMPONENTS+=(displayd) ;;
        --tray)          COMPONENTS+=(tray) ;;
        --clipboard)     COMPONENTS+=(clipboard) ;;
        --emoji)         COMPONENTS+=(emoji) ;;
        --files)         COMPONENTS+=(files) ;;
        --photos)        COMPONENTS+=(photos) ;;
        --mime)          COMPONENTS+=(mime) ;;
        --provide-mimetype) PROVIDE_MIMETYPE=true ;;
        --settings)      COMPONENTS+=(settings) ;;
        --all)           COMPONENTS+=(greeter lock displayd tray clipboard emoji files photos mime settings) ;;
        --force-cleanup) FORCE_CLEANUP=true ;;
        --dry-run)       DRY_RUN=true ;;
        --no-restart)    NO_RESTART=true ;;
        --yes|-y)        ASSUME_YES=true ;;
        -h|--help)       usage; exit 0 ;;
        *)               die "unknown option: $1 (try --help)" ;;
    esac
    shift
done

[[ -n $ACTION ]] || die "pick one of --install, --uninstall or --status"
if [[ $ACTION != status && ${#COMPONENTS[@]} -eq 0 ]]; then
    die "--$ACTION needs at least one component (--greeter, --lock, --displayd, --tray, --clipboard, --settings, --all)"
fi

has_component() {
    local want=$1 c
    for c in ${COMPONENTS[@]+"${COMPONENTS[@]}"}; do [[ $c == "$want" ]] && return 0; done
    return 1
}

# -------------------------------------------------------------- building

# build <package> [binary]
#
# `binary` defaults to the package name, which is true of every crate
# here except `hyprforge-tray`, whose binary is `hyprforge-trayd`. That
# assumption was baked in until the tray component was added, and it
# failed the way an assumption should: loudly, at the check below, rather
# than by installing nothing and reporting success.
#
# Note that `--dry-run` cannot catch this — it skips the build, so the
# proof never runs. The dry run for the tray component looked perfect.
# build <package> [binary...]
#
# The binaries default to the package name, which is the usual case; a
# package that ships more than one (hyprforge-mime: mimetype and
# mimeopen) names them, and each is proved to exist afterwards.
build() {
    local package=$1
    shift
    local binaries=("$@")
    [[ ${#binaries[@]} -gt 0 ]] || binaries=("$package")
    # The header already says which package, so in a dry run there is
    # nothing left to add: "would run: cargo build --release -p X" under
    # a heading reading "Building X" is the same fact twice, and across
    # seven packages it was fourteen lines saying seven things.
    step "Building $package"
    # A dry run does not build, so it cannot catch a package name that
    # is wrong — and that is exactly the mistake a dry run is run to
    # catch. `-p` takes a *package*, and naming a binary inside one
    # instead fails only at the real install. One `test -f` closes that
    # gap without a cargo invocation.
    [[ -f crates/$package/Cargo.toml ]] ||
        die "no crate at crates/$package — 'cargo build -p' takes a package name, not a binary name"
    if $DRY_RUN; then
        return 0
    fi
    cargo build --release -p "$package" 2>&1 | grep -vE "^\s*(Compiling|Finished)" || true
    for binary in "${binaries[@]}"; do
        [[ -x target/release/${binary} ]] || die "cargo did not produce target/release/$binary"
        ok "built target/release/$binary"
    done
}

# Installs a file only if it differs, then proves it landed.
#
# The proof is the point. `install` reports success for a copy that a
# later step overwrote, and a stale binary in $PREFIX looks exactly like
# a code change that did not work — which is a failure mode that has
# already eaten two debugging sessions here.
install_file() {
    local src=$1 dst=$2 mode=$3
    if [[ -e $dst ]] && cmp -s "$src" "$dst"; then
        mark_current
        return 0
    fi
    # Something on disk is about to differ from what was there. Recorded
    # so `restart_if_running` can tell "you installed a new binary" from
    # "you ran install again and nothing moved" — restarting a daemon
    # that did not change is a pointless interruption of whatever it was
    # doing.
    COMPONENT_CHANGED=true
    local verb="installed"
    [[ -e $dst ]] && verb="updated"
    run_root install -Dm"$mode" "$src" "$dst"
    # A dry run has already printed its "would run" line, and claiming
    # something was installed when nothing was is the one thing a
    # dry run must never do.
    $DRY_RUN && return 0
    cmp -s "$src" "$dst" || die "$dst does not match $src after installing it"
    ok "$verb $dst"
}

remove_file() {
    local path=$1
    if [[ ! -e $path ]]; then
        skip "$path is already gone"
        return 0
    fi
    run_root rm -f "$path"
    ok "removed $path"
}

# --------------------------------------------------------------- greeter

install_greeter() {
    COMPONENT_CHANGED=false
    build hyprforge-greet

    step "Greeter: the exported-look directory"
    # First, because without it the greeter runs but is stuck with
    # default colours and a fallback display scale, and both failures are
    # silent from the Settings app's side.
    install_file crates/hyprforge-greet/config/hyprforge-greet.sysusers \
        /usr/lib/sysusers.d/hyprforge-greet.conf 644
    install_file crates/hyprforge-greet/config/hyprforge-greet.tmpfiles \
        /usr/lib/tmpfiles.d/hyprforge-greet.conf 644
    flush_current
    run_root systemd-sysusers
    run_root systemd-tmpfiles --create
    if [[ -d $EXPORT_DIR ]] || $DRY_RUN; then
        ok "$EXPORT_DIR exists"
    else
        die "$EXPORT_DIR was not created; check systemd-tmpfiles output above"
    fi

    if id -nG "$USER" | tr ' ' '\n' | grep -qx hyprforge; then
        ok "$USER is in the hyprforge group"
    else
        run_root usermod -aG hyprforge "$USER"
        # Not a warning about something broken — a warning about
        # something that is true and will confuse you in ten minutes.
        warn "added $USER to the hyprforge group; this only takes effect at your next"
        warn "login, so 'id -nG' will not show it until then"
    fi

    step "Greeter: binary and compositor config"
    install_file target/release/hyprforge-greet "$PREFIX/hyprforge-greet" 755
    install_file crates/hyprforge-greet/config/hyprland-greeter.lua \
        "$GREETD_DIR/hyprland-greeter.lua" 644
    flush_current

    # A template with a placeholder in it is not a config, and the way
    # this fails is a login screen that tries to authenticate a user
    # named CHANGE_ME.
    if ! $DRY_RUN && sudo grep -q CHANGE_ME "$GREETD_DIR/hyprland-greeter.lua" 2>/dev/null; then
        step "Greeter: filling in the username"
        run_root sed -i "s/CHANGE_ME/$USER/" "$GREETD_DIR/hyprland-greeter.lua"
        ok "set the greeter's user to $USER in $GREETD_DIR/hyprland-greeter.lua"
    fi

    # Safety-critical, so it still gets a loud pointer right here — the
    # full explanation and the commands to test it are in the "Before
    # this does anything" list at the end, where the greeter's block is
    # deliberately last, but a skim of the action log must not miss this.
    warn "greetd's own config is deliberately NOT installed (installing it wrong is how"
    warn "a machine boots to something that cannot take a password) — see the last item"
    warn "in \"Before this does anything, you need to:\" below before you touch it."

    NEXT_GREETER=$(cat <<EOF
  ${D}greetd's own config is deliberately NOT installed. It decides which VT
  the machine logs in on, so installing it from a script is how you end up
  booting to something that cannot take a password.${N}

  To test on a spare VT, without committing to anything:

    sudo cp crates/hyprforge-greet/config/greetd.toml /etc/greetd/config.toml
    sudo sed -i 's/^vt = 1/vt = 2/; s/^switch = true/switch = false/' /etc/greetd/config.toml
    sudo systemctl start greetd        ${D}# note: start, not enable${N}

  Then ctrl+alt+F2 to look at it. ctrl+alt+F3 is a console if it goes wrong,
  and 'sudo systemctl stop greetd' undoes it completely.

  See crates/hyprforge-greet/INSTALL.md for committing to it properly.
EOF
)
    greeter_step_state
    STATE_GREETER=$CHECK_STATE; REASON_GREETER=$CHECK_REASON
}

uninstall_greeter() {
    step "Greeter: removing"
    if systemctl is-enabled greetd >/dev/null 2>&1; then
        # Refusing rather than disabling it: greetd being enabled means
        # it is how this machine logs in, and taking that away as a side
        # effect of removing a binary is how you get an unbootable
        # machine out of a cleanup command.
        die "greetd is still enabled — this machine logs in through it.
       Run 'sudo systemctl disable greetd' and set up another way to log
       in first, then remove the greeter."
    fi
    remove_file "$PREFIX/hyprforge-greet"

    if $FORCE_CLEANUP; then
        step "Greeter: forced cleanup"
        remove_file "$GREETD_DIR/hyprland-greeter.lua"
        remove_file /usr/lib/sysusers.d/hyprforge-greet.conf
        remove_file /usr/lib/tmpfiles.d/hyprforge-greet.conf
        if [[ -d $EXPORT_DIR ]]; then
            if confirm "remove $EXPORT_DIR and the exported look inside it?"; then
                run_root rm -rf /var/lib/hyprforge
                ok "removed /var/lib/hyprforge"
            else
                skip "kept $EXPORT_DIR"
            fi
        fi
        # The group is left alone on purpose. Removing a group that
        # still owns files elsewhere turns them into orphaned GIDs, and
        # an unused group costs nothing.
        skip "left the hyprforge group in place (an unused group is harmless)"
    else
        skip "kept $GREETD_DIR/hyprland-greeter.lua and $EXPORT_DIR (--force-cleanup removes them)"
    fi
}

# ------------------------------------------------------------------ lock

install_lock() {
    COMPONENT_CHANGED=false
    build hyprforge-lock
    step "Lock: binary and PAM stack"
    install_file target/release/hyprforge-lock "$PREFIX/hyprforge-lock" 755
    # Our own PAM file rather than borrowing hyprlock's, which has no
    # `account` stack and so rejects correct passwords.
    install_file crates/hyprforge-lock/pam/hyprforge-lock /etc/pam.d/hyprforge-lock 644
    flush_current

    NEXT_LOCK=$(cat <<EOF
  ${D}Nothing calls the lock screen on its own. Point your existing config at it:${N}

    ~/.config/hypr/hypridle.conf   lock_cmd = pidof hyprforge-lock || hyprforge-lock
    your keybind                   hyprforge-lock

  hypridle handles logind's Lock signal, so suspend and 'loginctl lock-session'
  both work once lock_cmd points here.
EOF
)
    lock_step_state
    STATE_LOCK=$CHECK_STATE; REASON_LOCK=$CHECK_REASON
}

uninstall_lock() {
    step "Lock: removing"
    # Named explicitly, never pkill -f: the pattern would match the shell
    # running it, kill that shell, and exit 144.
    if pgrep -x hyprforge-lock >/dev/null; then
        die "hyprforge-lock is running — it may be holding the session locked.
       Unlock first; removing the binary now would not unlock anything."
    fi
    remove_file "$PREFIX/hyprforge-lock"
    if $FORCE_CLEANUP; then
        remove_file /etc/pam.d/hyprforge-lock
    else
        skip "kept /etc/pam.d/hyprforge-lock (--force-cleanup removes it)"
    fi
    warn "check that nothing still calls hyprforge-lock:"
    warn "  grep -rn hyprforge-lock ~/.config/hypr/"
}

# -------------------------------------------------------------- displayd

install_displayd() {
    COMPONENT_CHANGED=false
    build hyprforge-displayd
    step "Display daemon"
    install_file target/release/hyprforge-displayd "$PREFIX/hyprforge-displayd" 755
    if [[ -x target/release/hyprforge-displayctl ]]; then
        install_file target/release/hyprforge-displayctl "$PREFIX/hyprforge-displayctl" 755
    fi

    # A user unit, so no sudo and no run_root.
    #
    # The packaged unit's ExecStart points at ~/.cargo/bin, which is
    # where `cargo install` puts things and is what the README's manual
    # route uses. This script installs to $PREFIX instead, so the path
    # is rewritten on the way in. Installing it verbatim would produce a
    # unit that fails with a status=203/EXEC nobody would connect to an
    # install script — the binary is there, just not where the unit
    # looks.
    local unit_dir="$HOME/.config/systemd/user"
    local unit=crates/hyprforge-displayd/packaging/hyprforge-displayd.service
    local generated
    generated=$(mktemp)
    # Trap rather than a plain rm: an early `die` between here and the
    # end would otherwise leave it behind.
    trap 'rm -f "$generated"' RETURN
    sed "s|^ExecStart=.*|ExecStart=$PREFIX/hyprforge-displayd run|" "$unit" > "$generated"

    if $DRY_RUN; then
        skip "would install $unit_dir/hyprforge-displayd.service (ExecStart=$PREFIX/hyprforge-displayd run)"
    elif [[ -e $unit_dir/hyprforge-displayd.service ]] && cmp -s "$generated" "$unit_dir/hyprforge-displayd.service"; then
        mark_current
    else
        install -Dm644 "$generated" "$unit_dir/hyprforge-displayd.service"
        systemctl --user daemon-reload
        ok "installed $unit_dir/hyprforge-displayd.service"
    fi
    flush_current

    NEXT_DISPLAYD=$(cat <<EOF
    systemctl --user enable --now hyprforge-displayd
EOF
)
    service_state --user hyprforge-displayd
    STATE_DISPLAYD=$CHECK_STATE; REASON_DISPLAYD=$CHECK_REASON

    restart_if_running hyprforge-displayd "the display daemon"
}

install_tray() {
    COMPONENT_CHANGED=false
    # Both binaries come out of the one crate: hyprforge-traymenu, the
    # right-click menu's popup, is a second [[bin]] in hyprforge-tray,
    # spawned directly by hyprforge-trayd rather than served over
    # com.canonical.dbusmenu — see hyprforge-tray's own module doc. Not a
    # component of its own: nothing launches it but the daemon. It was a
    # crate of its own once, and this line kept building it by that name
    # after it moved, failing every --install --tray.
    build hyprforge-tray hyprforge-trayd hyprforge-traymenu
    step "Tray icons"
    install_file target/release/hyprforge-trayd "$PREFIX/hyprforge-trayd" 755
    install_file target/release/hyprforge-traymenu "$PREFIX/hyprforge-traymenu" 755

    # Same rewrite as the display daemon's unit, for the same reason: the
    # packaged ExecStart points at ~/.cargo/bin and this script installs
    # to $PREFIX, so installing it verbatim yields a unit that fails with
    # status=203/EXEC and a binary sitting somewhere else entirely.
    local unit_dir="$HOME/.config/systemd/user"
    local unit=crates/hyprforge-tray/packaging/hyprforge-trayd.service
    local generated
    generated=$(mktemp)
    trap 'rm -f "$generated"' RETURN
    sed "s|^ExecStart=.*|ExecStart=$PREFIX/hyprforge-trayd|" "$unit" > "$generated"

    if $DRY_RUN; then
        skip "would install $unit_dir/hyprforge-trayd.service (ExecStart=$PREFIX/hyprforge-trayd)"
    elif [[ -e $unit_dir/hyprforge-trayd.service ]] && cmp -s "$generated" "$unit_dir/hyprforge-trayd.service"; then
        mark_current
    else
        install -Dm644 "$generated" "$unit_dir/hyprforge-trayd.service"
        systemctl --user daemon-reload
        ok "installed $unit_dir/hyprforge-trayd.service"
    fi
    flush_current

    NEXT_TRAY=$(cat <<EOF
    systemctl --user enable --now hyprforge-trayd

    Which icons appear is Settings' business, not this script's:
    Network and Bluetooth are on by default, keep awake and night light
    are off until switched on in Settings.

    A restart is how a rebuilt daemon reaches the bar. Running it by hand
    means a stale binary keeps running long after it was replaced, which
    is how two icons went missing after being switched on:
        systemctl --user restart hyprforge-trayd

    Right-click draws hyprforge-trayd's own menu (hyprforge-traymenu),
    themed like the rest of the suite, rather than whatever your bar
    would otherwise draw from com.canonical.dbusmenu. It opens below the
    icon that was clicked; ~/.config/hyprforge/tray.toml's menu_y_offset
    tunes how far below to clear your bar if the default doesn't.
EOF
)
    service_state --user hyprforge-trayd
    STATE_TRAY=$CHECK_STATE; REASON_TRAY=$CHECK_REASON

    restart_if_running hyprforge-trayd "the tray icons and their menus"
}

# Restarts a *running* user service whose binary this run replaced.
#
# This exists because the same mistake cost two debugging sessions in one
# day. An installed binary is not a running daemon: `hyprforge-clipd`
# kept serving an old socket protocol and answered "unknown variant
# `set-clipboard`" to a popup built against the new one, which looked
# like a bug in the clipboard rather than a stale process; and
# `hyprforge-trayd` kept advertising a menu it no longer served. Both
# times the install had succeeded and the symptom was somewhere else
# entirely.
#
# Three deliberate limits:
#
#   * Only if it is already **running**. Starting a service the user
#     chose not to enable is not this script's decision to make.
#   * Only if the binary actually **changed** this run, so re-running the
#     installer does not interrupt a daemon for nothing.
#   * **Never greetd.** It is a system service and it is the login
#     manager: restarting it takes the session down with it. The greeter
#     component deliberately has no call here, and `crates/hyprforge-greet/INSTALL.md`
#     covers committing to it by hand, from a spare VT, on purpose.
restart_if_running() {
    local unit=$1 label=$2
    $NO_RESTART && return 0
    $COMPONENT_CHANGED || return 0
    timeout 5 systemctl --user is-active --quiet "$unit" || return 0

    if $DRY_RUN; then
        skip "would restart $unit (it is running and its binary changed)"
        return 0
    fi
    if timeout 20 systemctl --user restart "$unit"; then
        ok "restarted $unit, so $label is running what was just installed"
    else
        # Not fatal: the files are installed and correct, and a restart
        # the user can do by hand is a smaller problem than an installer
        # that reports failure for something that did work.
        warn "couldn't restart $unit — run: systemctl --user restart $unit"
    fi
}

install_clipboard() {
    COMPONENT_CHANGED=false
    # hyprforge-clipmenu is a second [[bin]] in hyprforge-clipboard, for the
    # same reason the tray's menu is one in hyprforge-tray: a package's
    # binaries all come from one crate directory.
    build hyprforge-clipboard hyprforge-clipd hyprforge-clipmenu
    step "Clipboard"
    install_file target/release/hyprforge-clipd "$PREFIX/hyprforge-clipd" 755
    install_file target/release/hyprforge-clipmenu "$PREFIX/hyprforge-clipmenu" 755

    local unit_dir="$HOME/.config/systemd/user"
    local unit=crates/hyprforge-clipboard/packaging/hyprforge-clipd.service
    local generated
    generated=$(mktemp)
    trap 'rm -f "$generated"' RETURN
    sed "s|^ExecStart=.*|ExecStart=$PREFIX/hyprforge-clipd|" "$unit" > "$generated"

    if $DRY_RUN; then
        skip "would install $unit_dir/hyprforge-clipd.service (ExecStart=$PREFIX/hyprforge-clipd)"
    elif [[ -e $unit_dir/hyprforge-clipd.service ]] && cmp -s "$generated" "$unit_dir/hyprforge-clipd.service"; then
        mark_current
    else
        install -Dm644 "$generated" "$unit_dir/hyprforge-clipd.service"
        systemctl --user daemon-reload
        ok "installed $unit_dir/hyprforge-clipd.service"
    fi
    flush_current

    NEXT_CLIPBOARD=$(cat <<EOF
    systemctl --user enable --now hyprforge-clipd

    Then bind the popup. Hyprforge owns keybinds.lua, so the binding
