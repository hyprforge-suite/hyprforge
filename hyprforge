#!/usr/bin/env bash
# Installs, updates and removes the parts of Hyprforge that live outside
# this repository.
#
#     ./hyprforge --install   --greeter
#     ./hyprforge --uninstall --greeter --force-cleanup
#     ./hyprforge --status
#
# Install and update are the same operation. Everything here is
# idempotent: it builds, compares what is installed against what was
# built, and copies only what differs. Running it twice changes nothing
# the second time, which is what makes it safe to run whenever you are
# not sure.
#
# Why a script rather than instructions in a README: testing the greeter
# means reinstalling it repeatedly, and the failure that wastes the most
# time is testing a binary that was never replaced. This verifies the
# copy landed instead of assuming it, because assuming it cost two full
# debugging rounds.
#
# What it does not do is wire anything into the user's desktop. Enabling
# the daemons, the keybinds, hypridle's lock_cmd, default applications
# and the open/save dialog are `hyprforge-settings --setup`'s job — the
# same code as Settings' Set up page, which records what it changed so
# it can be undone — and --install ends by running it (see run_setup).
# This script used to print all of that as a page of instructions
# instead; only the greeter is still printed, and deliberately: a bad
# greetd config is a machine that cannot log in, so that step stays a
# human's.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

readonly PREFIX=/usr/local/bin
readonly EXPORT_DIR=/var/lib/hyprforge/greet
readonly GREETD_DIR=/etc/greetd

DRY_RUN=false
FORCE_CLEANUP=false
# See --provide-mimetype. Off by default: putting a `mimetype` on PATH
# changes how every application on the machine opens files, which is not
# something to do as a side effect of installing a file manager.
PROVIDE_MIMETYPE=false
ASSUME_YES=false
ACTION=
COMPONENTS=()

# ---------------------------------------------------------------- output

if [[ -t 1 ]]; then
    B=$'\033[1m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; D=$'\033[2m'; N=$'\033[0m'
else
    B=; G=; Y=; R=; D=; N=
fi

step() { printf '%s==> %s%s\n' "$B" "$*" "$N"; }
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
skip() { printf '  %s·%s %s%s%s\n' "$D" "$N" "$D" "$*" "$N"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; }
die()  { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

# "$dst is current" repeats up to a dozen times in a `--install --all` run
# and buries the handful of lines that actually say something changed.
# Tally it instead of printing each one, and flush the tally right where
# the individual lines used to sit — so the count stays exactly as
# inline as what it replaces; it just stops repeating itself.
CURRENT_COUNT=0
mark_current() { (( CURRENT_COUNT += 1 )) || true; }
flush_current() {
    (( CURRENT_COUNT > 0 )) || return 0
    skip "$CURRENT_COUNT already current"
    CURRENT_COUNT=0
}

COMPONENT_CHANGED=false
NO_RESTART=false

# The one step this script still prints rather than does: the greeter's.
# It is captured here and printed once, at the very end, after setup has
# run — not in the middle of the action log, where it used to sit among
# nine other components' blocks and got skimmed past. Every other block
# (enable this service, bind that key, point hypridle here, make Files
# the default for folders) is now an item `hyprforge-settings --setup`
# does and can undo; see run_setup.
NEXT_GREETER=

# One of done / todo / unknown (see "next-step checks" below), plus, for
# `unknown`, why it could not be determined. Set by install_greeter from
# a live but bounded check of the system — never from anything the
# install just did, since --dry-run must report the same state as a real
# run.
STATE_GREETER=;   REASON_GREETER=

# ------------------------------------------------------- next-step checks
#
# Three states, not two: `done` (verified satisfied — omit the step),
# `todo` (verified outstanding — print it exactly as before) and
# `unknown` (the check itself could not run: a missing command, an
# unreadable file, systemd not answering). Collapsing `unknown` into
# either neighbour is the same mistake CLAUDE.md calls out for a test
# that returns early and still prints `ok`: a step nobody could verify
# must never come out looking finished (the user stops looking for it)
# or vanish silently (worse — there is then no record it was even
# checked). It gets its own visible, marked line instead.
CHECK_STATE=
CHECK_REASON=

# service_state --user|--system <unit>
# Sets CHECK_STATE / CHECK_REASON. Every systemctl call here is wrapped
# in `timeout` — CLAUDE.md is explicit that nothing here waits on
# another process without a bound, and `is-enabled` talking to a wedged
# systemd is exactly that kind of call.
service_state() {
    local scope=$1 unit=$2 state rc=0
    CHECK_REASON=
    if ! command -v systemctl >/dev/null 2>&1; then
        CHECK_STATE=unknown; CHECK_REASON="systemctl not found"
        return
    fi
    if [[ $scope == --user ]]; then
        if state=$(timeout 3 systemctl --user is-enabled "$unit" 2>/dev/null); then rc=0; else rc=$?; fi
    else
        if state=$(timeout 3 systemctl is-enabled "$unit" 2>/dev/null); then rc=0; else rc=$?; fi
    fi
    # 124 is timeout's own "gave up" exit code; 126/127 mean the command
    # never even ran. Anything else is systemctl actually answering —
    # is-enabled exits non-zero for "disabled" and "not-found" too, and
    # that is a real answer, not a failure to answer.
    if (( rc == 124 || rc == 126 || rc == 127 )); then
        CHECK_STATE=unknown
        CHECK_REASON="systemctl $scope is-enabled $unit did not answer"
        return
    fi
    if [[ $state == enabled ]]; then
        CHECK_STATE=done
    else
        CHECK_STATE=todo
    fi
}

# The greeter step is the one CLAUDE.md's own safety warning is about —
# a bad greetd config can leave the machine unable to log in — so this
# is deliberately the most conservative check here. `done` only when
# greetd is enabled AND this specific session can be confirmed to have
# come in through it. Enabled-but-unconfirmed, or the check itself
# failing, both stay `todo`: understating readiness just repeats a
# warning that was already true, but overstating it hides a warning
# about the machine's boot target, and only one of those is safe to get
# wrong.
greeter_step_state() {
    service_state --system greetd
    if [[ $CHECK_STATE == unknown ]]; then
        return
    fi
    if [[ $CHECK_STATE == todo ]]; then
        # Not enabled at all: the machine has not committed to greetd,
        # so the full "test on a spare VT" warning must stay exactly as
        # visible as it is today. Nothing more to add.
        CHECK_REASON=
        return
    fi

    # greetd is enabled — but that alone only means it will be used on
    # the NEXT login, not that this session came in through it.
    if ! command -v loginctl >/dev/null 2>&1 || [[ -z ${XDG_SESSION_ID:-} ]]; then
        CHECK_STATE=unknown
        CHECK_REASON="greetd is enabled, but could not confirm this session logged in through it (no loginctl or session id)"
        return
    fi
    local service rc=0
    if service=$(timeout 3 loginctl show-session "$XDG_SESSION_ID" -p Service --value 2>/dev/null); then
        rc=0
    else
        rc=$?
    fi
    if (( rc == 124 || rc == 126 || rc == 127 )) || [[ -z $service ]]; then
        CHECK_STATE=unknown
        CHECK_REASON="loginctl did not answer about this session's Service"
        return
    fi
    if [[ $service == greetd ]]; then
        CHECK_STATE=done
    else
        # Conservative on purpose — see the function comment.
        CHECK_STATE=todo
        CHECK_REASON="greetd is enabled, but this session's Service is '$service', not greetd"
    fi
}

# The greeter's step, printed last — after setup has run and said what
# it did — because it is the one with real consequences (a bad greetd
# config can leave the machine unable to log in), so it belongs where it
# gets read most carefully: right before the script says it's done.
#
# Still three states, never two. `done` collapses to one line; `todo`
# prints the block; `unknown` prints the block *and* why it could not be
# checked — a step nobody could verify must neither look finished nor
# vanish (see "next-step checks" above).
print_next_steps() {
    [[ -n $NEXT_GREETER ]] || return 0   # the greeter was not part of this run

    if [[ $STATE_GREETER == done ]]; then
        step "Greeter"
        ok "this session logged in through greetd; nothing left to do by hand"
        return 0
    fi

    step "Greeter: one step left, by hand on purpose"
    if [[ $STATE_GREETER == unknown ]]; then
        printf '  %s(could not verify whether this is still needed: %s)%s\n' \
            "$Y" "$REASON_GREETER" "$N"
    elif [[ -n $REASON_GREETER ]]; then
        printf '  %s(%s)%s\n' "$D" "$REASON_GREETER" "$N"
    fi
    printf '%s\n' "$NEXT_GREETER"
}

# Every privileged action goes through here, so --dry-run is honest and
# there is exactly one place that can touch the system.
run_root() {
    if $DRY_RUN; then
        printf '  %s· would run: sudo %s%s\n' "$D" "$*" "$N"
        return 0
    fi
    sudo "$@"
}

confirm() {
    # A dry run answers *no*, and says what it would have asked. It used
    # to answer yes — and several callers act on a yes with a plain `rm`
    # rather than run_root, so `--dry-run --uninstall --settings
    # --force-cleanup` was one confirm away from `rm -rf ~/.config/hyprforge`.
    # "No" is the answer under which nothing happens, which is the only
    # answer a dry run may give. Checked before --yes, so `--dry-run --yes`
    # is still a dry run.
    if $DRY_RUN; then
        printf '  %s· would ask: %s%s\n' "$D" "$1" "$N"
        return 1
    fi
    $ASSUME_YES && return 0
    local reply
    read -rp "  $1 [y/N] " reply
    [[ $reply == [yY] ]]
}

# ----------------------------------------------------------------- usage

usage() {
    cat <<EOF
${B}Usage:${N} ./hyprforge <action> [components] [options]

${B}Actions${N}
  --install        Build and install, then run hyprforge-settings --setup
                   to wire it in (services, keybinds, default apps,
                   idle lock, the open/save dialog), asking per item.
                   Re-running updates in place.
  --uninstall      Offer to undo what setup changed, then remove what
                   --install put on the system.
  --status         Show what is installed, whether it is current, and
                   what setup has left to do.

${B}Components${N}
  --greeter        The login screen: hyprforge-greet, its compositor
                   config, and the exported-look directory.
                   Does NOT enable greetd — see --install --greeter output.
  --lock           The lock screen: hyprforge-lock and its PAM stack.
  --displayd       The display daemon's binary and systemd user unit.
  --tray           The tray icons (Wi-Fi, Bluetooth, keep awake, night
                   light): the daemon's binary and user unit.
  --clipboard      Clipboard history: the daemon's binary and user unit,
                   plus the popup its keybind launches.
  --notif          Notifications: notifd's binary and user unit, and
                   notifctl to drive its center and do-not-disturb.
                   Setup offers to replace dunst, mako or swaync.
  --settings       The Settings app and its launcher entry.
  --files          The file manager, and its launcher entry.
  --media          The media viewer (pictures, videos, 3D models), and its launcher entry.
  --mime           hyprforge-mimetype and hyprforge-mimeopen: what kind
                   of file is this, and what opens it. See
                   --provide-mimetype for the part that changes what the
                   rest of the desktop does.
  --emoji          The emoji picker popup, bound from Settings ->
                   Shortcuts (it has no daemon and no service).
  --all            Every component above.

${B}Options${N}
  --force-cleanup  On uninstall, also remove things shared with other
                   components or holding user data: the exported look,
                   the hyprforge group, /etc/greetd config. Off by
                   default because these are not yours alone.
  --provide-mimetype
                   With --mime, also provide the two commands under the
                   plain names `mimetype` and `mimeopen`, which is what
                   xdg-open looks for. This changes what happens when
                   *any* application on the desktop opens a file, so it
                   is off unless you ask. Uninstall removes the links
                   only if they still point at Hyprforge's binaries.
  --no-restart     Do not restart a running daemon whose binary changed.
                   The install still happens; the old process keeps
                   running until you restart it yourself.
  --dry-run        Print what would happen. Touches nothing; setup only
                   lists what it would do (--setup --list).
  --yes            Do not ask for confirmation; setup applies each
                   item's default (--setup --yes).
  -h, --help       This.

${B}Examples${N}
  ./hyprforge --install --greeter         # install or update the greeter
  ./hyprforge --status                    # what is installed, is it stale
  ./hyprforge --uninstall --greeter --force-cleanup
EOF
}

# ------------------------------------------------------------- arguments

[[ $# -eq 0 ]] && { usage; exit 1; }

set_action() {
    [[ -n $ACTION ]] && die "--install, --uninstall and --status are mutually exclusive"
    ACTION=$1
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --install)       set_action install ;;
        --uninstall)     set_action uninstall ;;
        --status)        set_action status ;;
        --greeter)       COMPONENTS+=(greeter) ;;
        --lock)          COMPONENTS+=(lock) ;;
        --displayd)      COMPONENTS+=(displayd) ;;
        --tray)          COMPONENTS+=(tray) ;;
        --clipboard)     COMPONENTS+=(clipboard) ;;
        --notif)         COMPONENTS+=(notif) ;;
        --emoji)         COMPONENTS+=(emoji) ;;
        --files)         COMPONENTS+=(files) ;;
        --media)        COMPONENTS+=(media) ;;
        --mime)          COMPONENTS+=(mime) ;;
        --provide-mimetype) PROVIDE_MIMETYPE=true ;;
        --settings)      COMPONENTS+=(settings) ;;
        --all)           COMPONENTS+=(greeter lock displayd tray clipboard notif emoji files media mime settings) ;;
        --force-cleanup) FORCE_CLEANUP=true ;;
        --dry-run)       DRY_RUN=true ;;
        --no-restart)    NO_RESTART=true ;;
        --yes|-y)        ASSUME_YES=true ;;
        -h|--help)       usage; exit 0 ;;
        *)               die "unknown option: $1 (try --help)" ;;
    esac
    shift
done

[[ -n $ACTION ]] || die "pick one of --install, --uninstall or --status"
if [[ $ACTION != status && ${#COMPONENTS[@]} -eq 0 ]]; then
    die "--$ACTION needs at least one component (--greeter, --lock, --displayd, --tray, --clipboard, --notif, --settings, --all)"
fi

has_component() {
    local want=$1 c
    for c in ${COMPONENTS[@]+"${COMPONENTS[@]}"}; do [[ $c == "$want" ]] && return 0; done
    return 1
}

# -------------------------------------------------------------- building

# build <package> [binary]
#
# `binary` defaults to the package name, which is true of every crate
# here except `hyprforge-tray`, whose binary is `hyprforge-trayd`. That
# assumption was baked in until the tray component was added, and it
# failed the way an assumption should: loudly, at the check below, rather
# than by installing nothing and reporting success.
#
# Note that `--dry-run` cannot catch this — it skips the build, so the
# proof never runs. The dry run for the tray component looked perfect.
# build <package> [binary...]
#
# The binaries default to the package name, which is the usual case; a
# package that ships more than one (hyprforge-mime: mimetype and
# mimeopen) names them, and each is proved to exist afterwards.
build() {
    local package=$1
    shift
    local binaries=("$@")
    [[ ${#binaries[@]} -gt 0 ]] || binaries=("$package")
    # The header already says which package, so in a dry run there is
    # nothing left to add: "would run: cargo build --release -p X" under
    # a heading reading "Building X" is the same fact twice, and across
    # seven packages it was fourteen lines saying seven things.
    step "Building $package"
    # A dry run does not build, so it cannot catch a package name that
    # is wrong — and that is exactly the mistake a dry run is run to
    # catch. `-p` takes a *package*, and naming a binary inside one
    # instead fails only at the real install. One `test -f` closes that
    # gap without a cargo invocation.
    #
    # The components are submodules, and one checked out without them is
    # an empty directory — a different mistake with a different fix.
    if [[ -d crates/$package && ! -f crates/$package/Cargo.toml ]] &&
        git config -f .gitmodules --get "submodule.crates/$package.path" >/dev/null 2>&1; then
        die "crates/$package is a submodule that is not checked out — run: git submodule update --init"
    fi
    [[ -f crates/$package/Cargo.toml ]] ||
        die "no crate at crates/$package — 'cargo build -p' takes a package name, not a binary name"
    if $DRY_RUN; then
        return 0
    fi
    cargo build --release -p "$package" 2>&1 | grep -vE "^\s*(Compiling|Finished)" || true
    for binary in "${binaries[@]}"; do
        [[ -x target/release/${binary} ]] || die "cargo did not produce target/release/$binary"
        ok "built target/release/$binary"
    done
}

# Installs a file only if it differs, then proves it landed.
#
# The proof is the point. `install` reports success for a copy that a
# later step overwrote, and a stale binary in $PREFIX looks exactly like
# a code change that did not work — which is a failure mode that has
# already eaten two debugging sessions here.
install_file() {
    local src=$1 dst=$2 mode=$3
    if [[ -e $dst ]] && cmp -s "$src" "$dst"; then
        mark_current
        return 0
    fi
    # Something on disk is about to differ from what was there. Recorded
    # so `restart_if_running` can tell "you installed a new binary" from
    # "you ran install again and nothing moved" — restarting a daemon
    # that did not change is a pointless interruption of whatever it was
    # doing.
    COMPONENT_CHANGED=true
    local verb="installed"
    [[ -e $dst ]] && verb="updated"
    run_root install -Dm"$mode" "$src" "$dst"
    # A dry run has already printed its "would run" line, and claiming
    # something was installed when nothing was is the one thing a
    # dry run must never do.
    $DRY_RUN && return 0
    cmp -s "$src" "$dst" || die "$dst does not match $src after installing it"
    ok "$verb $dst"
}

# The user-scope twins of run_root and remove_file: files in the user's
# own home that need no sudo. Every removal under $HOME goes through
# one of these, never a bare `rm`, because a bare `rm` is invisible to
# --dry-run — `uninstall_settings` deleted a real launcher entry during
# a dry run that way, and check.sh's "The installer's dry run touches
# nothing" step now runs every uninstall against a scratch home to keep
# it from happening again.
run_user() {
    if $DRY_RUN; then
        printf '  %s· would run: %s%s\n' "$D" "$*" "$N"
        return 0
    fi
    "$@"
}

# remove_user_path <path> [label]: a file or a whole directory.
remove_user_path() {
    local path=$1
    if [[ ! -e $path && ! -L $path ]]; then
        skip "$path is already gone"
        return 0
    fi
    if [[ -d $path && ! -L $path ]]; then
        run_user rm -rf "$path"
    else
        run_user rm -f "$path"
    fi
    $DRY_RUN || ok "removed $path"
}

remove_file() {
    local path=$1
    if [[ ! -e $path ]]; then
        skip "$path is already gone"
        return 0
    fi
    run_root rm -f "$path"
    # Same rule as install_file: a dry run has printed its "would run",
    # and must never then claim the thing happened.
    $DRY_RUN || ok "removed $path"
}

# --------------------------------------------------------------- greeter

install_greeter() {
    COMPONENT_CHANGED=false
    build hyprforge-greet

    step "Greeter: the exported-look directory"
    # First, because without it the greeter runs but is stuck with
    # default colours and a fallback display scale, and both failures are
    # silent from the Settings app's side.
    install_file crates/hyprforge-greet/config/hyprforge-greet.sysusers \
        /usr/lib/sysusers.d/hyprforge-greet.conf 644
    install_file crates/hyprforge-greet/config/hyprforge-greet.tmpfiles \
        /usr/lib/tmpfiles.d/hyprforge-greet.conf 644
    flush_current
    run_root systemd-sysusers
    run_root systemd-tmpfiles --create
    if [[ -d $EXPORT_DIR ]] || $DRY_RUN; then
        ok "$EXPORT_DIR exists"
    else
        die "$EXPORT_DIR was not created; check systemd-tmpfiles output above"
    fi

    if id -nG "$USER" | tr ' ' '\n' | grep -qx hyprforge; then
        ok "$USER is in the hyprforge group"
    else
        run_root usermod -aG hyprforge "$USER"
        # Not a warning about something broken — a warning about
        # something that is true and will confuse you in ten minutes.
        warn "added $USER to the hyprforge group; this only takes effect at your next"
        warn "login, so 'id -nG' will not show it until then"
    fi

    step "Greeter: binary and compositor config"
    install_file target/release/hyprforge-greet "$PREFIX/hyprforge-greet" 755
    install_file crates/hyprforge-greet/config/hyprland-greeter.lua \
        "$GREETD_DIR/hyprland-greeter.lua" 644
    flush_current

    # A template with a placeholder in it is not a config, and the way
    # this fails is a login screen that tries to authenticate a user
    # named CHANGE_ME.
    if ! $DRY_RUN && sudo grep -q CHANGE_ME "$GREETD_DIR/hyprland-greeter.lua" 2>/dev/null; then
        step "Greeter: filling in the username"
        run_root sed -i "s/CHANGE_ME/$USER/" "$GREETD_DIR/hyprland-greeter.lua"
        ok "set the greeter's user to $USER in $GREETD_DIR/hyprland-greeter.lua"
    fi

    # Safety-critical, so it still gets a loud pointer right here — the
    # full explanation and the commands to test it are printed at the
    # very end, deliberately last, but a skim of the action log must not
    # miss this.
    warn "greetd's own config is deliberately NOT installed (installing it wrong is how"
    warn "a machine boots to something that cannot take a password) — see \"Greeter\""
    warn "at the end of this run before you touch it."

    NEXT_GREETER=$(cat <<EOF
  ${D}greetd's own config is deliberately NOT installed. It decides which VT
  the machine logs in on, so installing it from a script is how you end up
  booting to something that cannot take a password.${N}

  To test on a spare VT, without committing to anything:

    sudo cp crates/hyprforge-greet/config/greetd.toml /etc/greetd/config.toml
    sudo sed -i 's/^vt = 1/vt = 2/; s/^switch = true/switch = false/' /etc/greetd/config.toml
    sudo systemctl start greetd        ${D}# note: start, not enable${N}

  Then ctrl+alt+F2 to look at it. ctrl+alt+F3 is a console if it goes wrong,
  and 'sudo systemctl stop greetd' undoes it completely.

  See crates/hyprforge-greet/INSTALL.md for committing to it properly.
EOF
)
    greeter_step_state
    STATE_GREETER=$CHECK_STATE; REASON_GREETER=$CHECK_REASON
}

uninstall_greeter() {
    step "Greeter: removing"
    greeter_removable
    remove_file "$PREFIX/hyprforge-greet"
    uninstall_greeter_cleanup
}

greeter_removable() {
    # Bounded, through service_state, so a systemd that does not answer
    # is `unknown` — and unknown refuses too. "Could not check whether
    # this machine logs in through greetd" is no permission to remove it.
    service_state --system greetd
    if [[ $CHECK_STATE == done ]]; then
        # Refusing rather than disabling it: greetd being enabled means
        # it is how this machine logs in, and taking that away as a side
        # effect of removing a binary is how you get an unbootable
        # machine out of a cleanup command.
        die "greetd is still enabled — this machine logs in through it.
       Run 'sudo systemctl disable greetd' and set up another way to log
       in first, then remove the greeter."
    elif [[ $CHECK_STATE == unknown ]]; then
        die "could not tell whether this machine logs in through greetd ($CHECK_REASON),
       so the greeter was left in place. Try again once systemctl answers."
    fi
}

uninstall_greeter_cleanup() {
    if $FORCE_CLEANUP; then
        step "Greeter: forced cleanup"
        remove_file "$GREETD_DIR/hyprland-greeter.lua"
        remove_file /usr/lib/sysusers.d/hyprforge-greet.conf
        remove_file /usr/lib/tmpfiles.d/hyprforge-greet.conf
        if [[ -d $EXPORT_DIR ]]; then
            if confirm "remove $EXPORT_DIR and the exported look inside it?"; then
                run_root rm -rf /var/lib/hyprforge
                ok "removed /var/lib/hyprforge"
            else
                skip "kept $EXPORT_DIR"
            fi
        fi
        # The group is left alone on purpose. Removing a group that
        # still owns files elsewhere turns them into orphaned GIDs, and
        # an unused group costs nothing.
        skip "left the hyprforge group in place (an unused group is harmless)"
    else
        skip "kept $GREETD_DIR/hyprland-greeter.lua and $EXPORT_DIR (--force-cleanup removes them)"
    fi
}

# ------------------------------------------------------------------ lock

install_lock() {
    COMPONENT_CHANGED=false
    build hyprforge-lock
    step "Lock: binary and PAM stack"
    install_file target/release/hyprforge-lock "$PREFIX/hyprforge-lock" 755
    # Our own PAM file rather than borrowing hyprlock's, which has no
    # `account` stack and so rejects correct passwords.
    install_file crates/hyprforge-lock/pam/hyprforge-lock /etc/pam.d/hyprforge-lock 644
    flush_current
    # Nothing calls the lock screen on its own. Setup's `idle-lock` item
    # points hypridle's lock_cmd at it (so suspend and `loginctl
    # lock-session` lock too) and `bind-lock` binds Super+Escape. The
    # check this replaced grepped hypridle.conf and never saw the
    # idle.conf Settings writes and hypridle.conf sources, so it said
    # "todo" on a machine that was already wired.
}

lock_removable() {
    # Named explicitly, never pkill -f: the pattern would match the shell
    # running it, kill that shell, and exit 144.
    if pgrep -x hyprforge-lock >/dev/null; then
        die "hyprforge-lock is running — it may be holding the session locked.
       Unlock first; removing the binary now would not unlock anything."
    fi
}

uninstall_lock() {
    step "Lock: removing"
    lock_removable
    remove_file "$PREFIX/hyprforge-lock"
    if $FORCE_CLEANUP; then
        remove_file /etc/pam.d/hyprforge-lock
    else
        skip "kept /etc/pam.d/hyprforge-lock (--force-cleanup removes it)"
    fi
    warn "check that nothing still calls hyprforge-lock:"
    warn "  grep -rn hyprforge-lock ~/.config/hypr/"
}

# -------------------------------------------------------------- displayd

install_displayd() {
    COMPONENT_CHANGED=false
    build hyprforge-displayd
    step "Display daemon"
    install_file target/release/hyprforge-displayd "$PREFIX/hyprforge-displayd" 755
    if [[ -x target/release/hyprforge-displayctl ]]; then
        install_file target/release/hyprforge-displayctl "$PREFIX/hyprforge-displayctl" 755
    fi

    # A user unit, so no sudo and no run_root.
    #
    # The packaged unit's ExecStart points at ~/.cargo/bin, which is
    # where `cargo install` puts things and is what docs/displays.md's manual
    # route uses. This script installs to $PREFIX instead, so the path
    # is rewritten on the way in. Installing it verbatim would produce a
    # unit that fails with a status=203/EXEC nobody would connect to an
    # install script — the binary is there, just not where the unit
    # looks.
    local unit_dir="$HOME/.config/systemd/user"
    local unit=crates/hyprforge-displayd/packaging/hyprforge-displayd.service
    local generated
    generated=$(mktemp)
    # Trap rather than a plain rm: an early `die` between here and the
    # end would otherwise leave it behind.
    trap 'rm -f "$generated"' RETURN
    sed "s|^ExecStart=.*|ExecStart=$PREFIX/hyprforge-displayd run|" "$unit" > "$generated"

    if $DRY_RUN; then
        skip "would install $unit_dir/hyprforge-displayd.service (ExecStart=$PREFIX/hyprforge-displayd run)"
    elif [[ -e $unit_dir/hyprforge-displayd.service ]] && cmp -s "$generated" "$unit_dir/hyprforge-displayd.service"; then
        mark_current
    else
        install -Dm644 "$generated" "$unit_dir/hyprforge-displayd.service"
        systemctl --user daemon-reload
        ok "installed $unit_dir/hyprforge-displayd.service"
    fi
    flush_current

    # Installs the unit; never enables it. Enabling is setup's
    # `service-displayd` item, which records it so --undo can reverse
    # it — this script enabling it too would be a second writer nobody
    # recorded.
    restart_if_running hyprforge-displayd "the display daemon"
}

install_tray() {
    COMPONENT_CHANGED=false
    # Both binaries come out of the one crate: hyprforge-traymenu, the
    # right-click menu's popup, is a second [[bin]] in hyprforge-tray,
    # spawned directly by hyprforge-trayd rather than served over
    # com.canonical.dbusmenu — see hyprforge-tray's own module doc. Not a
    # component of its own: nothing launches it but the daemon. It was a
    # crate of its own once, and this line kept building it by that name
    # after it moved, failing every --install --tray.
    build hyprforge-tray hyprforge-trayd hyprforge-traymenu
    step "Tray icons"
    install_file target/release/hyprforge-trayd "$PREFIX/hyprforge-trayd" 755
    install_file target/release/hyprforge-traymenu "$PREFIX/hyprforge-traymenu" 755

    # Same rewrite as the display daemon's unit, for the same reason: the
    # packaged ExecStart points at ~/.cargo/bin and this script installs
    # to $PREFIX, so installing it verbatim yields a unit that fails with
    # status=203/EXEC and a binary sitting somewhere else entirely.
    local unit_dir="$HOME/.config/systemd/user"
    local unit=crates/hyprforge-tray/packaging/hyprforge-trayd.service
    local generated
    generated=$(mktemp)
    trap 'rm -f "$generated"' RETURN
    sed "s|^ExecStart=.*|ExecStart=$PREFIX/hyprforge-trayd|" "$unit" > "$generated"

    if $DRY_RUN; then
        skip "would install $unit_dir/hyprforge-trayd.service (ExecStart=$PREFIX/hyprforge-trayd)"
    elif [[ -e $unit_dir/hyprforge-trayd.service ]] && cmp -s "$generated" "$unit_dir/hyprforge-trayd.service"; then
        mark_current
    else
        install -Dm644 "$generated" "$unit_dir/hyprforge-trayd.service"
        systemctl --user daemon-reload
        ok "installed $unit_dir/hyprforge-trayd.service"
    fi
    flush_current

    # Enabling is setup's `service-trayd` item, as for displayd. Which
    # icons appear is Settings' business too.
    restart_if_running hyprforge-trayd "the tray icons and their menus"
}

# Restarts a *running* user service whose binary this run replaced.
#
# This exists because the same mistake cost two debugging sessions in one
# day. An installed binary is not a running daemon: `hyprforge-clipd`
# kept serving an old socket protocol and answered "unknown variant
# `set-clipboard`" to a popup built against the new one, which looked
# like a bug in the clipboard rather than a stale process; and
# `hyprforge-trayd` kept advertising a menu it no longer served. Both
# times the install had succeeded and the symptom was somewhere else
# entirely.
#
# Three deliberate limits:
#
#   * Only if it is already **running**. Starting a service the user
#     chose not to enable is not this script's decision to make.
#   * Only if the binary actually **changed** this run, so re-running the
#     installer does not interrupt a daemon for nothing.
#   * **Never greetd.** It is a system service and it is the login
#     manager: restarting it takes the session down with it. The greeter
#     component deliberately has no call here, and `crates/hyprforge-greet/INSTALL.md`
#     covers committing to it by hand, from a spare VT, on purpose.
restart_if_running() {
    local unit=$1 label=$2
    $NO_RESTART && return 0
    $COMPONENT_CHANGED || return 0
    timeout 5 systemctl --user is-active --quiet "$unit" || return 0

    if $DRY_RUN; then
        skip "would restart $unit (it is running and its binary changed)"
        return 0
    fi
    if timeout 20 systemctl --user restart "$unit"; then
        ok "restarted $unit, so $label is running what was just installed"
    else
        # Not fatal: the files are installed and correct, and a restart
        # the user can do by hand is a smaller problem than an installer
        # that reports failure for something that did work.
        warn "couldn't restart $unit — run: systemctl --user restart $unit"
    fi
}

install_clipboard() {
    COMPONENT_CHANGED=false
    # hyprforge-clipmenu is a second [[bin]] in hyprforge-clipboard, for the
    # same reason the tray's menu is one in hyprforge-tray: a package's
    # binaries all come from one crate directory.
    build hyprforge-clipboard hyprforge-clipd hyprforge-clipmenu
    step "Clipboard"
    install_file target/release/hyprforge-clipd "$PREFIX/hyprforge-clipd" 755
    install_file target/release/hyprforge-clipmenu "$PREFIX/hyprforge-clipmenu" 755

    local unit_dir="$HOME/.config/systemd/user"
    local unit=crates/hyprforge-clipboard/packaging/hyprforge-clipd.service
    local generated
    generated=$(mktemp)
    trap 'rm -f "$generated"' RETURN
    sed "s|^ExecStart=.*|ExecStart=$PREFIX/hyprforge-clipd|" "$unit" > "$generated"

    if $DRY_RUN; then
        skip "would install $unit_dir/hyprforge-clipd.service (ExecStart=$PREFIX/hyprforge-clipd)"
    elif [[ -e $unit_dir/hyprforge-clipd.service ]] && cmp -s "$generated" "$unit_dir/hyprforge-clipd.service"; then
        mark_current
    else
        install -Dm644 "$generated" "$unit_dir/hyprforge-clipd.service"
        systemctl --user daemon-reload
        ok "installed $unit_dir/hyprforge-clipd.service"
    fi
    flush_current

    # Setup's `service-clipd` enables the daemon and `bind-clipboard`
    # binds the popup through Settings' own shortcuts model — Hyprforge
    # owns keybinds.lua, so a binding written any other way is lost on
    # the next save.
    restart_if_running hyprforge-clipd "clipboard history"
}

# notif is a cargo workspace of its own (see `exclude` in Cargo.toml: its
# zbus runs on async-io, the suite's on tokio, and one workspace would
# unify them into a panic), so `build` — which is `cargo build -p` in
# this workspace — cannot reach it. It is built from its own directory,
# into this workspace's target/, so every other part of this script
# (status, the stale check) finds its binaries where it finds the rest.
#
# The binaries are still `notifd` and `notifctl`, the names they had as
# notif: users bind `notifctl center` and write `layerrule = blur, notif`.
install_notif() {
    COMPONENT_CHANGED=false
    step "Building hyprforge-notif"
    [[ -f crates/hyprforge-notif/Cargo.toml ]] || die "no workspace at crates/hyprforge-notif"
    if ! $DRY_RUN; then
        (cd crates/hyprforge-notif && CARGO_TARGET_DIR="$PWD/../../target" \
            cargo build --release --workspace 2>&1 | grep -vE "^\s*(Compiling|Finished)") || true
        for binary in notifd notifctl; do
            [[ -x target/release/$binary ]] || die "cargo did not produce target/release/$binary"
            ok "built target/release/$binary"
        done
    fi
    step "Notifications"
    install_file target/release/notifd "$PREFIX/notifd" 755
    install_file target/release/notifctl "$PREFIX/notifctl" 755

    local unit_dir="$HOME/.config/systemd/user"
    local unit=crates/hyprforge-notif/notifd.service
    local generated
    generated=$(mktemp)
    trap 'rm -f "$generated"' RETURN
    sed "s|^ExecStart=.*|ExecStart=$PREFIX/notifd|" "$unit" > "$generated"

    if $DRY_RUN; then
        skip "would install $unit_dir/notifd.service (ExecStart=$PREFIX/notifd)"
    elif [[ -e $unit_dir/notifd.service ]] && cmp -s "$generated" "$unit_dir/notifd.service"; then
        mark_current
    else
        install -Dm644 "$generated" "$unit_dir/notifd.service"
        systemctl --user daemon-reload
        ok "installed $unit_dir/notifd.service"
    fi
    flush_current

    # A packaged notifd (the old notif-git, or hyprforge-notif from the
    # PKGBUILD) ships /usr/lib/systemd/user/notifd.service. The unit just
    # installed has the same name and takes precedence, so the service now
    # runs this build — which is the point, but two copies of a daemon on
    # one machine is worth hearing about, not discovering.
    if [[ -e /usr/bin/notifd ]]; then
        local owner
        owner=$(pacman -Qqo /usr/bin/notifd 2>/dev/null) || owner=
        warn "a packaged notifd is also installed${owner:+ ($owner)}; this build's unit overrides its service. Remove it with: sudo pacman -R ${owner:-<its package>}"
    fi

    # Only one program can own org.freedesktop.Notifications, so enabling
    # notifd beside dunst, mako or swaync is a race at every login. Setup's
    # `service-notifd` item names the other daemon before it replaces it,
    # and records it so --undo brings it back; `notif-blur` and
    # `bind-notifications`/`bind-dnd` do the rest. (The layer-rule syntax
    # this used to print was hyprlang, which a Lua config rejects.)
    restart_if_running notifd "notifications"
}

install_emoji() {
    COMPONENT_CHANGED=false
    build hyprforge-emojimenu
    step "Emoji picker"
    install_file target/release/hyprforge-emojimenu "$PREFIX/hyprforge-emojimenu" 755

    flush_current

    # No service and no daemon: a popup that runs, does one thing and
    # exits. Its key is setup's `bind-emoji` item.
    #
    # The one thing setup cannot do is install a package, and without an
    # emoji font every cell renders as an identical empty box — which
    # looks like a broken picker, not a missing font. The pacman package
    # depends on noto-fonts-emoji; a source install has nothing that
    # does, so it is asked for here — only when it is actually missing,
    # and fontconfig is bounded like every other process this talks to.
    local fonts rc=0
    if ! command -v fc-list >/dev/null 2>&1; then
        warn "could not check for an emoji font (no fc-list); the picker needs one, e.g. noto-fonts-emoji"
    elif fonts=$(timeout 10 fc-list ':charset=1f600' family 2>/dev/null); then
        if [[ -z $fonts ]]; then
            warn "no emoji font is installed, so every emoji will draw as an empty box:"
            warn "  sudo pacman -S noto-fonts-emoji"
        fi
    else
        rc=$?
        warn "fc-list did not answer (exit $rc), so whether an emoji font is installed is unknown"
    fi
}

# Tells the running session bus to read its service files again.
#
# dbus-broker, Arch's bus, does not watch the directory: a service file
# written while the session is running is not there to it until a reload
# or the next login. Found the first time the dialog was turned on — the
# portal answered every request with "Backend call failed: The name is
# not activatable", with the file sitting in place. Bounded like every
# other call to another process here; failing to reload is a warning
# with the command to run, never a failed install.
reload_session_bus() {
    $DRY_RUN && return 0
    if ! timeout 5 busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
        org.freedesktop.DBus ReloadConfig >/dev/null 2>&1; then
        warn "the session bus did not reload — log out and back in, or run: busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig"
    fi
}

uninstall_files() {
    step "File manager: removing"
    remove_file "$PREFIX/hyprforge-files"
    remove_file "$PREFIX/hyprforge-files-admin"
    remove_file "$POLKIT_ACTIONS_DIR/org.hyprforge.files.admin.policy"
    remove_user_path "$DESKTOP_DIR/hyprforge-files.desktop"
    remove_file "$PREFIX/hyprforge-files-portal"
    remove_file "$PORTAL_DIR/hyprforge.portal"
    remove_user_path "$DBUS_SERVICES_DIR/$PORTAL_BUS_NAME.service"
    # The FileManager1 claim goes with it, which hands the name back to
    # whichever file manager /usr/share's services name.
    remove_user_path "$DBUS_SERVICES_DIR/$FILE_MANAGER1_NAME.service"
    reload_session_bus
    # Nothing else to undo: no service, no config written by the
    # installer. The user's own files.toml is deliberately left alone —
    # uninstalling a program is not a reason to throw away the
    # preferences they set in it, and reinstalling should find them
    # still there.
}

# ------------------------------------------------------------------ mime
#
# Two commands, and one decision about names.
#
# `xdg-open`, on a desktop it does not recognise (Hyprland is one), asks
# `xdg-mime query filetype`, which runs `mimetype` if it is on PATH and
# falls back to `file --mime-type` if it is not. That fallback reads
# bytes and never names: an STL becomes application/octet-stream, has no
# default application, and xdg-open — finding nothing — works down a
# built-in list of web browsers. Installing these as `mimetype` and
# `mimeopen` is what fixes that for every application, not just ours.
#
# It is also, unavoidably, taking over two command names that belong to
# somebody else's package, so it happens only with --provide-mimetype.
install_mime() {
    COMPONENT_CHANGED=false
    build hyprforge-mime hyprforge-mimetype hyprforge-mimeopen
    step "Mime tools"
    install_file target/release/hyprforge-mimetype "$PREFIX/hyprforge-mimetype" 755
    install_file target/release/hyprforge-mimeopen "$PREFIX/hyprforge-mimeopen" 755

    if ! $PROVIDE_MIMETYPE; then
        skip "not providing \`mimetype\`/\`mimeopen\` (pass --provide-mimetype)"
        flush_current
        return 0
    fi
    for name in mimetype mimeopen; do
        local target="$PREFIX/hyprforge-$name" link="$PREFIX/$name"
        # An existing file that is not ours is another package's, and
        # replacing it would leave that package's own files half
        # present. Say so and leave it; PATH order is the user's to
        # settle, not this script's.
        if [[ -e $link && ! -L $link ]]; then
            warn "$link exists and is not a link — leaving it alone"
            continue
        fi
        if [[ -L $link && $(readlink -f "$link") == "$target" ]]; then
            mark_current
            continue
        fi
        run_root ln -sfn "$target" "$link"
        $DRY_RUN || ok "linked $link -> $target"
    done
    flush_current
    if command -v /usr/bin/mimetype >/dev/null && ! $DRY_RUN; then
        warn "perl-file-mimeinfo is also installed; whichever of $PREFIX and /usr/bin comes first in PATH wins"
    fi
}

uninstall_mime() {
    step "Mime tools: removing"
    # The links first, and only if they still point at ours — a link
    # somebody re-pointed at the perl version is theirs now.
    for name in mimetype mimeopen; do
        local link="$PREFIX/$name"
        if [[ -L $link && $(readlink -f "$link") == "$PREFIX/hyprforge-$name" ]]; then
            remove_file "$link"
        elif [[ -e $link ]]; then
            skip "$link is not ours; leaving it"
        fi
    done
    remove_file "$PREFIX/hyprforge-mimetype"
    remove_file "$PREFIX/hyprforge-mimeopen"
    # Nothing else: the mimeapps.list these can write is the user's own
    # record of which application opens what, and uninstalling a command
    # is not a reason to forget it.
}

uninstall_emoji() {
    step "Emoji picker: removing"
    remove_file "$PREFIX/hyprforge-emojimenu"
    # The chosen skin tone is the user's, and is left alone for the same
    # reason the clipboard history is.
    if [[ -e "$HOME/.config/hyprforge/emojimenu.toml" ]]; then
        skip "kept your emoji settings in ~/.config/hyprforge/emojimenu.toml"
    fi
}

# Removes only what install_notif put here. A packaged notifd ships a
# unit with the same name in /usr/lib, so disabling the service outright
# would also switch off a notification daemon that belongs to pacman.
uninstall_notif() {
    step "Notifications: removing"
    if [[ -e "$HOME/.config/systemd/user/notifd.service" ]]; then
        if $DRY_RUN; then
            skip "would remove the user unit"
        else
            if [[ ! -e /usr/lib/systemd/user/notifd.service ]] \
                && timeout 5 systemctl --user is-enabled notifd >/dev/null 2>&1; then
                timeout 20 systemctl --user disable --now notifd || true
                ok "disabled the user service"
            fi
            remove_user_path "$HOME/.config/systemd/user/notifd.service"
            timeout 20 systemctl --user daemon-reload || true
            [[ -e /usr/lib/systemd/user/notifd.service ]] &&
                skip "notifd.service now means the packaged /usr/bin/notifd again; it takes over at the next restart"
        fi
    fi
    remove_file "$PREFIX/notifd"
    remove_file "$PREFIX/notifctl"
    if [[ -e "$HOME/.config/notif/config.toml" ]]; then
        skip "kept your notification settings in ~/.config/notif/config.toml"
    fi
}

uninstall_clipboard() {
    step "Clipboard: removing"
    if ! $DRY_RUN && timeout 5 systemctl --user is-enabled hyprforge-clipd >/dev/null 2>&1; then
        timeout 20 systemctl --user disable --now hyprforge-clipd || true
        ok "disabled the user service"
    fi
    if [[ -e "$HOME/.config/systemd/user/hyprforge-clipd.service" ]]; then
        remove_user_path "$HOME/.config/systemd/user/hyprforge-clipd.service"
        $DRY_RUN || timeout 20 systemctl --user daemon-reload || true
    fi
    remove_file "$PREFIX/hyprforge-clipd"
    remove_file "$PREFIX/hyprforge-clipmenu"
    # The history itself is the user's, and is left alone. Say so, because
    # silently keeping data is as surprising as silently deleting it.
    if [[ -e "$HOME/.config/hyprforge/clipboard" ]]; then
        skip "kept your clipboard history in ~/.config/hyprforge/clipboard"
    fi
}

uninstall_tray() {
    step "Tray icons: removing"
    if ! $DRY_RUN && timeout 5 systemctl --user is-enabled hyprforge-trayd >/dev/null 2>&1; then
        timeout 20 systemctl --user disable --now hyprforge-trayd || true
        ok "disabled the user service"
    fi
    if [[ -e "$HOME/.config/systemd/user/hyprforge-trayd.service" ]]; then
        remove_user_path "$HOME/.config/systemd/user/hyprforge-trayd.service"
        $DRY_RUN || timeout 20 systemctl --user daemon-reload || true
    fi
    remove_file "$PREFIX/hyprforge-trayd"
    remove_file "$PREFIX/hyprforge-traymenu"
}

uninstall_displayd() {
    step "Display daemon: removing"
    if ! $DRY_RUN && timeout 5 systemctl --user is-enabled hyprforge-displayd >/dev/null 2>&1; then
        timeout 20 systemctl --user disable --now hyprforge-displayd || true
        ok "disabled the user service"
    fi
    remove_file "$PREFIX/hyprforge-displayd"
    remove_file "$PREFIX/hyprforge-displayctl"
    if [[ -e "$HOME/.config/systemd/user/hyprforge-displayd.service" ]]; then
        remove_user_path "$HOME/.config/systemd/user/hyprforge-displayd.service"
        $DRY_RUN || timeout 20 systemctl --user daemon-reload || true
    fi
    if $FORCE_CLEANUP; then
        # Display profiles are user data: what monitors you have and how
        # you arranged them. Never removed without being asked.
        local profiles="${XDG_CONFIG_HOME:-$HOME/.config}/hyprforge/display-profiles.toml"
        if [[ -e $profiles ]] && confirm "remove your saved display profiles ($profiles)?"; then
            remove_user_path "$profiles"
        fi
    fi
}

# -------------------------------------------------------------- settings

# The launcher entry, in the user's own data dir rather than
# /usr/share/applications. It names no absolute path and needs no root,
# and a per-user install is the honest description of what this is.
readonly DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"

# Where xdg-desktop-portal finds backends (compiled into it; there is no
# per-user directory), and where the session bus finds a user's services.
readonly PORTAL_DIR=/usr/share/xdg-desktop-portal/portals
readonly DBUS_SERVICES_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dbus-1/services"
readonly PORTAL_BUS_NAME=org.freedesktop.impl.portal.desktop.hyprforge
readonly FILE_MANAGER1_NAME=org.freedesktop.FileManager1
# Where polkit reads actions from. There is no per-user directory: an
# action is the system's say-so about what may be run as root.
readonly POLKIT_ACTIONS_DIR=/usr/share/polkit-1/actions

install_files() {
    COMPONENT_CHANGED=false
    # One crate, two binaries: the window and the open/save dialog.
    build hyprforge-files hyprforge-files hyprforge-files-portal hyprforge-files-admin
    step "File manager"
    install_file target/release/hyprforge-files "$PREFIX/hyprforge-files" 755

    # "Open as administrator": the helper, and the polkit action that
    # names it. pkexec matches the action by the helper's full path, so
    # the packaged file's /usr/bin is rewritten to this install's prefix.
    install_file target/release/hyprforge-files-admin "$PREFIX/hyprforge-files-admin" 755
    local policy
    policy=$(mktemp)
    sed "s|/usr/bin/hyprforge-files-admin|$PREFIX/hyprforge-files-admin|" \
        crates/hyprforge-files/packaging/org.hyprforge.files.admin.policy > "$policy"
    install_file "$policy" "$POLKIT_ACTIONS_DIR/org.hyprforge.files.admin.policy" 644
    rm -f "$policy"

    local entry=crates/hyprforge-files/packaging/hyprforge-files.desktop
    local dst="$DESKTOP_DIR/hyprforge-files.desktop"
    if $DRY_RUN; then
        skip "would install $dst"
    elif [[ -e $dst ]] && cmp -s "$entry" "$dst"; then
        mark_current
    else
        install -Dm644 "$entry" "$dst"
        # Not every launcher needs this and it is absent on some systems,
        # so its failure is not the install failing. It matters more here
        # than for the Settings app, though: this entry declares
        # MimeType=inode/directory, and that association is exactly what
        # this command rebuilds — without it, "open containing folder"
        # from another application still goes wherever it went before.
        command -v update-desktop-database >/dev/null &&
            update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
        ok "installed $dst"
    fi
    flush_current

    # The open/save dialog. The descriptor can only go where the portal
    # looks — /usr/share/xdg-desktop-portal/portals is compiled into it,
    # with no per-user directory — and registers the backend for nothing:
    # see that file's comment. The D-Bus activation file is the user's
    # own, pointing at this install's binary rather than /usr/bin's.
    install_file target/release/hyprforge-files-portal "$PREFIX/hyprforge-files-portal" 755
    install_file crates/hyprforge-files/packaging/hyprforge.portal \
        "$PORTAL_DIR/hyprforge.portal" 644
    local activation="$DBUS_SERVICES_DIR/$PORTAL_BUS_NAME.service"
    local wanted
    wanted=$(printf '[D-BUS Service]\nName=%s\nExec=%s\n' "$PORTAL_BUS_NAME" "$PREFIX/hyprforge-files-portal")
    if $DRY_RUN; then
        skip "would install $activation"
    elif [[ -e $activation ]] && [[ $(cat "$activation") == "$wanted" ]]; then
        mark_current
    else
        mkdir -p "$DBUS_SERVICES_DIR"
        printf '%s\n' "$wanted" > "$activation"
        ok "installed $activation"
        reload_session_bus
    fi
    flush_current

    # org.freedesktop.FileManager1: what a browser's "Show in Folder" and
    # an editor's "Reveal in File Manager" call. Claimed on install, on
    # purpose — Files is the file manager this suite installs, and a
    # file in the user's own services directory is read before
    # /usr/share's, so it wins over Nemo's or Nautilus's there. The
    # service is this binary with --dbus-service; it exits when idle.
    local fm1="$DBUS_SERVICES_DIR/$FILE_MANAGER1_NAME.service"
    wanted=$(printf '[D-BUS Service]\nName=%s\nExec=%s --dbus-service\n' "$FILE_MANAGER1_NAME" "$PREFIX/hyprforge-files")
    if $DRY_RUN; then
        skip "would install $fm1"
    elif [[ -e $fm1 ]] && [[ $(cat "$fm1") == "$wanted" ]]; then
        mark_current
    else
        mkdir -p "$DBUS_SERVICES_DIR"
        printf '%s\n' "$wanted" > "$fm1"
        ok "installed $fm1"
        reload_session_bus
    fi
    flush_current

    # No service and no daemon: a window that opens when asked and exits
    # when closed. (The dialog's service above is started by D-Bus when an
    # application asks for a dialog, and by nothing else.) Unlike the
    # Settings app it takes no single-instance lock either — two file
    # manager windows onto two directories is how people move files.
    #
    # Making it the default for folders (`default-folders`) and every
    # application's open/save dialog (`portal-dialog`, which keeps the
    # rest of the user's portals.conf) are setup items. A missing
    # gvfs-smb is said in the app, where a share would have been.
}

install_media() {
    COMPONENT_CHANGED=false
    build hyprforge-media
    step "Image viewer"
    install_file target/release/hyprforge-media "$PREFIX/hyprforge-media" 755

    local entry=crates/hyprforge-media/packaging/hyprforge-media.desktop
    local dst="$DESKTOP_DIR/hyprforge-media.desktop"
    if $DRY_RUN; then
        skip "would install $dst"
    elif [[ -e $dst ]] && cmp -s "$entry" "$dst"; then
        mark_current
    else
        install -Dm644 "$entry" "$dst"
        # The entry declares the four image types the viewer decodes, and
        # this is what makes the desktop's MIME cache hear about them.
        command -v update-desktop-database >/dev/null &&
            update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
        ok "installed $dst"
    fi
    flush_current
    retire_photos

    # Like the file manager: a window, no service, no single-instance
    # lock. Nothing here makes it the default for pictures — that is
    # setup's `default-images` item, which records the handler it
    # replaced so --undo puts it back.
}

# Media was Hyprforge Photos until 2026-09-26, and the rename installed
# the new binary and entry beside the old ones without removing them, so
# a machine installed before it had two identical viewers in the launcher —
# one of them a frozen build that still held some MIME defaults. Guarded
# on existence so a machine that never had Photos hears nothing about it.
retire_photos() {
    local entry="$DESKTOP_DIR/hyprforge-photos.desktop"
    [[ -e $PREFIX/hyprforge-photos || -e $entry ]] || return 0
    step "Image viewer: removing the old Hyprforge Photos"
    [[ -e $PREFIX/hyprforge-photos ]] && remove_file "$PREFIX/hyprforge-photos"
    if [[ -e $entry ]]; then
        remove_user_path "$entry"
        command -v update-desktop-database >/dev/null &&
            update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
    fi
}

uninstall_media() {
    step "Image viewer: removing"
    remove_file "$PREFIX/hyprforge-media"
    remove_user_path "$DESKTOP_DIR/hyprforge-media.desktop"
    retire_photos
    # media.toml is the user's and stays, for the reason uninstall_files
    # gives for files.toml.
}

install_settings() {
    COMPONENT_CHANGED=false
    build hyprforge-settings
    step "Settings app"
    install_file target/release/hyprforge-settings "$PREFIX/hyprforge-settings" 755

    local entry=crates/hyprforge-settings/packaging/hyprforge-settings.desktop
    local dst="$DESKTOP_DIR/hyprforge-settings.desktop"
    if $DRY_RUN; then
        skip "would install $dst"
    elif [[ -e $dst ]] && cmp -s "$entry" "$dst"; then
        mark_current
    else
        install -Dm644 "$entry" "$dst"
        # Not every launcher needs this and it is absent on some systems,
        # so its failure is not the install failing.
        command -v update-desktop-database >/dev/null &&
            update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
        ok "installed $dst"
    fi
    flush_current
}

# ----------------------------------------------------------------- setup
#
# Everything this script used to print as "Before this does anything, you
# need to:" is now `hyprforge-settings --setup`: the same items, the same
# code as Settings' Set up page, and a record in setup.toml of what each
# one replaced so --undo can put it back. The installer only decides how
# to ask:
#
#   --dry-run       --setup --list   (states only; a dry run changes nothing)
#   --yes           --setup --yes    (each item's default, no questions)
#   a terminal      --setup          (asks per item, [Y/n] or [y/N])
#   no terminal     --setup --list   (nobody to answer; says how to run it)
#
# Its exit status is reported, never fatal: 1 is "an item failed", and
# every file this run installed is still correct. 2 is a usage error —
# which is also how a hyprforge-settings from before --setup existed
# answers, since it refuses any flag it does not know.

# The hyprforge-settings to ask, on stdout; non-zero when there is none.
# $PREFIX's first: that is the one this script installs (and the one a
# real --install just replaced), and a /usr/bin copy from the package
# may be an older build.
settings_binary() {
    if [[ -x $PREFIX/hyprforge-settings ]]; then
        printf '%s\n' "$PREFIX/hyprforge-settings"
    else
        command -v hyprforge-settings 2>/dev/null
    fi
}

run_setup() {
    step "Set up"
    local bin
    if ! bin=$(settings_binary); then
        if has_component settings && $DRY_RUN; then
            skip "hyprforge-settings is not installed yet, so setup cannot be previewed;"
            skip "a real --install runs it once Settings is in $PREFIX"
        else
            skip "hyprforge-settings is not installed, so nothing was wired in."
            skip "Install it (./hyprforge --install --settings) and its Set up page, or"
            skip "hyprforge-settings --setup, enables the services and adds the keybinds."
        fi
        return 0
    fi

    local args=(--setup) bound=()
    if $DRY_RUN; then
        args+=(--list); bound=(timeout 30)
        # The dry run did not install anything, so this is the binary
        # already on the machine, which a real run might replace.
        has_component settings && skip "previewing with the installed $bin; a real run uses the new build"
    elif $ASSUME_YES; then
        # Unattended, so bounded: every call setup makes is bounded on
        # its own, and this is the bound on all of them together.
        args+=(--yes); bound=(timeout 300)
    elif [[ ! -t 0 ]]; then
        args+=(--list); bound=(timeout 30)
        skip "no terminal to answer setup's questions; showing what it would do."
        skip "Run hyprforge-settings --setup (or open Settings -> Set up) to apply it."
    fi
    # Interactive is the one call left unbounded: it is waiting on a
    # person, not on another process.

    local rc=0
    ${bound[@]+"${bound[@]}"} "$bin" "${args[@]}" || rc=$?
    case $rc in
        0)   if [[ ${args[*]} == *--list* ]]; then
                 ok "listed what setup would do; nothing was changed"
             else
                 # An open Settings window takes a writing request itself
                 # and exits 0 here — see offer_setup_undo.
                 ok "setup finished — or, if Settings was open, its Set up page took over"
             fi ;;
        1)   warn "setup could not do every item (it says which above); the install itself is complete."
             warn "Settings -> Set up shows each item's state and can retry it." ;;
        2)   warn "$bin did not accept ${args[*]} — it may be a build from before --setup existed."
             warn "Reinstall Settings (./hyprforge --install --settings), then run: hyprforge-settings --setup" ;;
        124) warn "setup did not finish within its time limit; run hyprforge-settings --setup to see where it stopped" ;;
        *)   warn "setup exited with status $rc; run hyprforge-settings --setup to see why" ;;
    esac
    return 0
}

# Before --uninstall removes anything: offer to unwire what setup wired,
# while hyprforge-settings — the only thing that knows what that was —
# still exists. Afterwards the record in setup.toml outlives the binary
# that can read it, and the keybinds, default applications and portal
# line it wrote keep pointing at programs that are gone.
#
# Only the items that belong to what is being removed: uninstalling the
# clipboard alone is not a reason to unwire the lock screen. Removing
# Settings undoes everything, since nothing would be left to undo it
# later. And never as a failure — a declined or failed undo leaves the
# user's config as it was, which is the safe direction for an uninstall
# to err in.
#
# The ids are setup's own (`hyprforge-settings --setup --porcelain`
# lists them); an item that was never applied is nothing for undo to do.
setup_ids_for() {
    case $1 in
        displayd)  echo service-displayd ;;
        tray)      echo service-trayd ;;
        clipboard) echo service-clipd bind-clipboard ;;
        notif)     echo service-notifd bind-notifications bind-dnd notif-blur ;;
        emoji)     echo bind-emoji ;;
        files)     echo bind-files default-folders portal-dialog show-in-folder ;;
        media)     echo default-images ;;
        lock)      echo bind-lock idle-lock lock-restore ;;
    esac
}

offer_setup_undo() {
    local bin ids=() c
    bin=$(settings_binary) || return 0
    if ! has_component settings; then
        for c in ${COMPONENTS[@]+"${COMPONENTS[@]}"}; do
            # Word-splitting on purpose: each line is a list of ids.
            # shellcheck disable=SC2207
            ids+=($(setup_ids_for "$c"))
        done
        (( ${#ids[@]} )) || return 0
    fi
    local what=${ids[*]:-everything setup changed}
    step "Set up: undo"
    if $DRY_RUN; then
        skip "would offer: $bin --setup --undo ${ids[*]:-(every item, since Settings goes too)}"
        return 0
    fi
    if ! confirm "first undo what Hyprforge's setup changed for this ($what)?"; then
        skip "left setup's changes in place; hyprforge-settings --setup --undo reverts them while it is installed"
        return 0
    fi
    local rc=0
    timeout 300 "$bin" --setup --undo ${ids[@]+"${ids[@]}"} || rc=$?
    case $rc in
        # An open Settings window takes the request instead (one writer
        # to shortcuts.toml) and exit 0 cannot tell the two apart — so
        # say both, rather than claim an undo that may be waiting on a
        # button.
        0) ok "setup's undo finished — or, if Settings was open, its Set up page is showing it" ;;
        2) warn "$bin did not accept --setup --undo — it may predate setup; nothing was undone" ;;
        *) warn "setup's undo did not finish cleanly (exit $rc); what it could not undo is listed above" ;;
    esac
    return 0
}

uninstall_settings() {
    step "Settings app: removing"
    remove_file "$PREFIX/hyprforge-settings"
    local dst="$DESKTOP_DIR/hyprforge-settings.desktop"
    # Through remove_user_path: this was a bare `rm`, and a dry run
    # deleted a real launcher entry with it.
    remove_user_path "$dst"
    if ! $DRY_RUN; then
        command -v update-desktop-database >/dev/null &&
            timeout 30 update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
    fi
    if $FORCE_CLEANUP; then
        # Everything the app has ever configured lives here. It is the
        # most valuable thing this script can touch, so it is the only
        # removal that asks twice: --force-cleanup AND a prompt.
        local config="${XDG_CONFIG_HOME:-$HOME/.config}/hyprforge"
        if [[ -d $config ]] && confirm "remove ALL Hyprforge settings in $config?"; then
            remove_user_path "$config"
        fi
    fi
}

# ---------------------------------------------------------------- status

# Reports installed / missing / stale. "Stale" is the one that matters:
# it is the difference between "my change did nothing" and "I am running
# last week's binary", and it is not visible any other way.
status_binary() {
    local name=$1 built=target/release/$1 installed=$PREFIX/$1
    if [[ ! -e $installed ]]; then
        printf '  %s·%s %-24s %snot installed%s\n' "$D" "$N" "$name" "$D" "$N"
    elif [[ ! -e $built ]]; then
        printf '  %s✓%s %-24s installed %s(nothing built to compare against)%s\n' \
            "$G" "$N" "$name" "$D" "$N"
    elif cmp -s "$built" "$installed"; then
        printf '  %s✓%s %-24s installed, matches the current build\n' "$G" "$N" "$name"
    else
        printf '  %s!%s %-24s %sSTALE%s — differs from target/release/%s\n' \
            "$Y" "$N" "$name" "$Y" "$N" "$name"
    fi
}

# Whether the desktop-wide names point at ours — see --provide-mimetype.
# A link pointing somewhere else is somebody else's and is reported as
# such rather than as missing, because "not installed" and "installed,
# and another package won" are different things to be told.
status_mime_link() {
    local name=$1 link="$PREFIX/$1" ours="$PREFIX/hyprforge-$1"
    if [[ -L $link && $(readlink -f "$link") == "$ours" ]]; then
        printf '  %s✓%s %-24s %s -> hyprforge-%s\n' "$G" "$N" "$name provided" "$link" "$name"
    elif [[ -e $link ]]; then
        printf '  %s!%s %-24s %s exists but is not ours%s\n' "$Y" "$N" "$name provided" "$link" "$N"
    else
        printf '  %s·%s %-24s %snot provided (--provide-mimetype)%s\n' "$D" "$N" "$name provided" "$D" "$N"
    fi
}

status_path() {
    local label=$1 path=$2
    if [[ -e $path ]]; then
        printf '  %s✓%s %-24s %s\n' "$G" "$N" "$label" "$path"
    else
        printf '  %s·%s %-24s %smissing: %s%s\n' "$D" "$N" "$label" "$D" "$path" "$N"
    fi
}

# `is-enabled` prints "not-found" *and* exits non-zero for a unit that
# does not exist, so a bare `|| echo` prints twice. Take the output when
# there is any, and only substitute when there is none.
status_service() {
    local scope=$1 unit=$2 note=$3 state rc=0
    if [[ $scope == --user ]]; then
        state=$(timeout 3 systemctl --user is-enabled "$unit" 2>/dev/null) || rc=$?
    else
        state=$(timeout 3 systemctl is-enabled "$unit" 2>/dev/null) || rc=$?
    fi
    # A systemctl that gave up (124) or never ran (126/127) has said
    # nothing, and "not installed" would be a claim it did not make.
    if (( rc == 124 || rc == 126 || rc == 127 )); then
        printf '  %s?%s %-24s %ssystemctl did not answer%s\n' "$Y" "$N" "$unit" "$Y" "$N"
        return 0
    fi
    # systemd says "not-found" for a unit that was never installed. That
    # is its wording for an internal state, not an answer to the question
    # a person asked, so it is translated here.
    [[ -n $state && $state != not-found ]] || state="not installed"

    local mark=$D colour=$D
    case $state in
        enabled)  mark=$G colour=$N ;;
        disabled) mark=$Y colour=$N ;;
    esac
    printf '  %s●%s %-24s %s%s%s\n' "$mark" "$N" "$unit" "$colour" "$state" "$N"

    case $state in
        # Worth a line only when it is on: "greetd is not enabled" needs
        # no explanation, "this machine logs in through it" does.
        enabled)
            [[ -n $note ]] && printf '    %s%s%s\n' "$D" "$note" "$N"
            ;;
        # Installed but off is the state most likely to be an accident —
        # the unit is there, so somebody meant to use it.
        disabled)
            if [[ $scope == --user ]]; then
                # Setup is what enables a suite service now, and records
                # it so --undo can reverse it; see "Set up" below.
                printf '    %shyprforge-settings --setup (or: systemctl --user enable --now %s)%s\n' "$D" "$unit" "$N"
            else
                printf '    %ssudo systemctl enable --now %s%s\n' "$D" "$unit" "$N"
            fi
            ;;
    esac
}

# What setup would say about each of its items, from
# `hyprforge-settings --setup --porcelain`: one `<id>\t<state>\t<reason>`
# line per item, state one of done / todo / unavailable / unknown.
#
# The four stay four. `unavailable` (the component is not installed —
# nothing to do, nothing wrong) is dim; `unknown` (the check could not
# run) is marked as its own thing in yellow, never folded into done or
# todo — the same rule as the next-step checks above. A line in a state
# this script does not know is shown as exactly that, not guessed at:
# it means Settings is newer than this script.
status_setup() {
    step "Set up"
    local bin
    if ! bin=$(settings_binary); then
        skip "hyprforge-settings is not installed, so there is no setup to ask"
        return 0
    fi
    local out rc=0
    out=$(timeout 30 "$bin" --setup --porcelain 2>/dev/null) || rc=$?
    case $rc in
        0) ;;
        2)   warn "$bin does not know --setup (a build from before it existed?)"; return 0 ;;
        124) warn "$bin --setup --porcelain did not answer within 30s"; return 0 ;;
        *)   warn "$bin --setup --porcelain failed (exit $rc)"; return 0 ;;
    esac
    if [[ -z $out ]]; then
        # Not "nothing to set up": --porcelain always lists every item,
        # so empty output means something answered that was not setup.
        warn "$bin --setup --porcelain answered with no items — could not read setup's state"
        return 0
    fi

    local id state reason todo=0 mark colour
    while IFS=$'\t' read -r id state reason; do
        [[ -n $id ]] || continue
        case $state in
            done)        mark=$G✓ colour=$N ;;
            todo)        mark=$Y! colour=$N; (( todo += 1 )) ;;
            unavailable) mark=$D· colour=$D ;;
            unknown)     mark=$Y? colour=$Y; state="could not check" ;;
            *)           mark=$Y? colour=$Y; state="unrecognised state '$state'" ;;
        esac
        printf '  %s%s %-24s %s%s%s%s\n' "$mark" "$N" "$id" "$colour" "$state" \
            "${reason:+: $reason}" "$N"
    done <<<"$out"
    if (( todo )); then
        printf '    %shyprforge-settings --setup, or Settings -> Set up%s\n' "$D" "$N"
    fi
}

# What is installed, in one line, so `--status` answers the question it
# was run to answer without being read end to end.
status_summary() {
    local installed=() missing=() stale=()
    local name
    # Every binary show_status lists, and in the same order. This counted
    # eight while the list above it showed twelve — the emoji picker, the
    # file manager and both MIME tools were missing — so the summary
    # line under-reported what was installed and never called them stale.
    for name in hyprforge-greet hyprforge-lock hyprforge-displayd \
                hyprforge-trayd hyprforge-traymenu hyprforge-clipd hyprforge-clipmenu \
                notifd notifctl hyprforge-emojimenu hyprforge-files hyprforge-media \
                hyprforge-mimetype hyprforge-mimeopen hyprforge-settings; do
        if [[ ! -e $PREFIX/$name ]]; then
            missing+=("$name")
        elif [[ -e target/release/$name ]] && ! cmp -s "target/release/$name" "$PREFIX/$name"; then
            stale+=("$name")
        else
            installed+=("$name")
        fi
    done

    step "Summary"
    printf '  %s%d installed%s' "$G" "${#installed[@]}" "$N"
    (( ${#stale[@]} )) && printf ', %s%d stale%s' "$Y" "${#stale[@]}" "$N"
    (( ${#missing[@]} )) && printf ', %s%d not installed%s' "$D" "${#missing[@]}" "$N"
    printf '\n'
    if (( ${#stale[@]} )); then
        printf '    %sstale means you rebuilt and did not reinstall: %s%s\n' \
            "$Y" "${stale[*]}" "$N"
        printf '    %s./hyprforge --install --all%s\n' "$D" "$N"
    fi
    if (( ${#missing[@]} )); then
        printf '    %snot installed: %s%s\n' "$D" "${missing[*]}" "$N"
    fi
}

show_status() {
    step "Binaries in $PREFIX"
    status_binary hyprforge-greet
    status_binary hyprforge-lock
    status_binary hyprforge-displayd
    status_binary hyprforge-trayd
    status_binary hyprforge-traymenu
    status_binary hyprforge-clipd
    status_binary hyprforge-clipmenu
    status_binary notifd
    status_binary notifctl
    status_binary hyprforge-emojimenu
    status_binary hyprforge-files
    status_binary hyprforge-files-portal
    status_binary hyprforge-files-admin
    status_binary hyprforge-media
    status_binary hyprforge-mimetype
    status_binary hyprforge-mimeopen
    status_binary hyprforge-settings

    step "Supporting files"
    status_path "greeter compositor" "$GREETD_DIR/hyprland-greeter.lua"
    status_path "greetd config"      "$GREETD_DIR/config.toml"
    status_path "lock PAM stack"     /etc/pam.d/hyprforge-lock
    status_path "exported look"      "$EXPORT_DIR/theme.toml"
    status_path "exported layout"    "$EXPORT_DIR/monitors.lua"
    status_path "launcher entry"     "$DESKTOP_DIR/hyprforge-settings.desktop"
    status_mime_link mimetype
    status_mime_link mimeopen

    step "Services"
    status_service --system greetd "this machine logs in through the greeter"
    status_service --user hyprforge-displayd "monitor layouts are applied and remembered"
    status_service --user hyprforge-trayd "the tray icons are running"
    status_service --user hyprforge-clipd "clipboard history is being recorded"
    status_service --user notifd "notifications are being shown"

    status_setup

    step "Session"
    if command -v loginctl >/dev/null && [[ -n ${XDG_SESSION_ID:-} ]]; then
        loginctl show-session "$XDG_SESSION_ID" \
            -p Service -p Type -p TTY -p LockedHint 2>/dev/null |
            sed 's/^/  /'
    else
        skip "no session to report on"
    fi

    status_summary
}

# ------------------------------------------------------------------ main

if [[ $ACTION != status ]] && ! $DRY_RUN; then
    # Asked for once, up front, rather than surprising you halfway
    # through a build. Also fails early on a machine where sudo will not
    # authenticate, which is better than failing after a five-minute
    # compile.
    step "Asking for sudo up front"
    sudo -v || die "this needs sudo for $PREFIX, /etc and /usr/lib"
fi

case $ACTION in
    status)
        show_status
        ;;
    install)
        has_component greeter  && install_greeter
        has_component lock     && install_lock
        has_component displayd && install_displayd
        has_component tray && install_tray
        has_component clipboard && install_clipboard
        has_component notif && install_notif
        has_component emoji && install_emoji
        has_component files && install_files
        has_component media && install_media
        has_component mime && install_mime
        has_component settings && install_settings
        # After every component, so setup sees all of them installed and
        # does not report as unavailable what this run just put in place;
        # before the greeter's step, so that is still the last thing read.
        run_setup
        print_next_steps
        step "Done"
        $DRY_RUN && warn "this was a dry run; nothing changed"
        ;;
    uninstall)
        # The refusals first. An uninstall that is going to stop at
        # "greetd is still enabled" must stop before setup's undo has
        # unwired the user's config, not after — or the config is gone
        # and the binaries are all still there.
        has_component greeter && greeter_removable
        has_component lock && lock_removable
        # Then the undo, while hyprforge-settings still exists to do it.
        offer_setup_undo
        has_component greeter  && uninstall_greeter
        has_component lock     && uninstall_lock
        has_component clipboard && uninstall_clipboard
        has_component notif && uninstall_notif
        has_component emoji && uninstall_emoji
        has_component files && uninstall_files
        has_component media && uninstall_media
        has_component mime && uninstall_mime
        has_component tray && uninstall_tray
        has_component displayd && uninstall_displayd
        has_component settings && uninstall_settings
        step "Done"
        $DRY_RUN && warn "this was a dry run; nothing changed"
        ;;
esac
